{
  "description": "Shift_JIS の日本語の名前と DTD を持つ自作 BED の位置・標高・地層・貫入試験・孔内水位を、各 API とバインディングで比較する（#824）",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "BED0001.XML",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "boring",
        "input": "BED0001.XML"
      },
      "expect": {
        "/result/standards": [
          "JIS A 0205-2019"
        ],
        "/result/name": "No.1",
        "/result/position/longitude": 139.75,
        "/result/position/latitude": 35.5,
        "/result/datum": "jgd2024",
        "/result/elevation": {
          "value": 5.5,
          "datum": "tokyo_bay",
          "realization": "survey_2024"
        },
        "/result/length": 8,
        "/result/layers": [
          {
            "bottom": 8,
            "name": "砂"
          }
        ],
        "/result/penetrations": [
          {
            "depth": 1.15,
            "blows": 10,
            "penetration": 300
          }
        ],
        "/result/water_levels": [
          {
            "date": "2026-10-02",
            "depth": 2.4
          }
        ],
        "/diagnostics": []
      }
    },
    {
      "push": {
        "name": "b.xml",
        "text": "<BORING DTD_version=\"2.00\"/>"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "boring",
        "input": "b.xml"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "boring.file.invalid"
      }
    }
  ]
}
