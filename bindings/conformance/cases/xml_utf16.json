{
  "description": "UTF-16LE の BOM と UTF-16BE の明示宣言を持つ LandXML を読む。日本語・補助平面の名前と測点の値、復号の予算停止、宣言とバイト順の不一致を各言語で比較する（#468）",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "little.xml",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "little.xml",
        "budget": {
          "decoded_bytes": 0
        }
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "budget.decoded-bytes.exceeded"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "little.xml"
      },
      "expect": {
        "/result/format": "landxml",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "civil",
        "doc": "little.xml",
        "distances": [
          5
        ]
      },
      "expect": {
        "/result/alignment": "道路😀",
        "/result/positions/0/northing": 5
      }
    },
    {
      "push": {
        "name": "big.xml",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "big.xml"
      },
      "expect": {
        "/result/format": "landxml",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "civil",
        "doc": "big.xml",
        "distances": [
          5
        ]
      },
      "expect": {
        "/result/alignment": "道路😀",
        "/result/positions/0/northing": 5
      }
    },
    {
      "push": {
        "name": "mismatch.xml",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "mismatch.xml"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "xml.document.invalid"
      }
    }
  ]
}
