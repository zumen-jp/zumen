      }
    },
    {
      "call": {
        "v": 1,
        "op": "building_apply",
        "doc": "a.ifc",
        "edits": [
          {
            "kind": "property",
            "id": "0000000000000000000080",
            "hash": "v1:ff70eef55c7c9a7a7e4236fb0d0112ab",
            "set": "Pset_DoorCommon",
            "name": "IsExternal",
            "value": {
