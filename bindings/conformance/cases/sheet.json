{
  "description": "sheet は、表（xlsx と CSV）を様式を知らずに読み、シートごとのセルの値・数式・結合セルを返す（#391）。数式は計算せず、保存された値を返す。CSV の文字コードは、BOM か UTF-8 として正しければ utf_8、そうでなければ shift_jis とする。閉じない引用符は csv.quote.invalid を足して終わりまでを値にする。",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "a.xlsx",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "sheet",
        "input": "a.xlsx"
      },
      "expect": {
        "/result/format": "xlsx",
        "/result/sheets/0/name": "数量",
        "/result/sheets/0/rows": 2,
        "/result/sheets/0/columns": 3,
        "/result/sheets/0/cells": [
          {
            "row": 0,
            "column": 0,
            "kind": "text",
            "value": "工種"
          },
          {
            "row": 1,
            "column": 0,
            "kind": "text",
            "value": "土工"
          },
          {
            "row": 1,
            "column": 1,
            "kind": "number",
            "value": "12.5"
          },
          {
            "row": 1,
            "column": 2,
            "kind": "number",
            "value": "25",
            "formula": "B2*2"
          }
        ],
        "/result/sheets/0/merged": [
          {
            "first_row": 0,
            "first_column": 0,
            "last_row": 0,
            "last_column": 2
          }
        ],
        "/diagnostics": []
      }
    },
    {
      "push": {
        "name": "b.csv",
        "text": "工種,備考\r\n\"土工, 掘削\",\"「\"\"注\"\"」\"\r\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "sheet",
        "input": "b.csv"
      },
      "expect": {
        "/result/format": "csv",
        "/result/encoding": "utf_8",
        "/result/sheets/0/cells/2": {
          "row": 1,
          "column": 0,
          "kind": "text",
          "value": "土工, 掘削"
        },
        "/result/sheets/0/cells/3/value": "「\"注\"」",
        "/diagnostics": []
      }
    },
    {
      "push": {
        "name": "c.tsv",
        "hex": "8d488eed09909497ca0a8c408ded09330a"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "sheet",
        "input": "c.tsv",
        "delimiter": "tab"
      },
      "expect": {
        "/result/encoding": "shift_jis",
        "/result/sheets/0/cells/1/value": "数量",
        "/result/sheets/0/rows": 2,
        "/diagnostics": []
      }
    },
    {
      "push": {
        "name": "d.csv",
        "text": "a,\"b\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "sheet",
        "input": "d.csv"
      },
      "expect": {
        "/result/sheets/0/cells/1/value": "b\n",
        "/diagnostics/0/code": "csv.quote.invalid"
      }
    }
  ]
}
