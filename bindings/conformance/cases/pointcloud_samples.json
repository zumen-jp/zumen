{
  "description": "PDAL が作った公開サンプルの非圧縮 LAS 1.2（点形式 3、synthetic フラグを持つ 1 点）を開き、点数・範囲・属性と全点を返す応答・診断のハッシュをネイティブと wasm で照らす。期待値は laspy 2.7.0 と PDAL のテストで確認した。ヘッダーの尺度・原点と全点の保持属性は crates/zumen-las/tests/external.rs で別に照合する（#804）。",
  "module": "pointcloud",
  "steps": [
    {
      "push": {
        "name": "pdal.las",
        "file": "samples/las/pdal-synthetic.las"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "pdal.las"
      },
      "expect": {
        "/result/format": "las"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "pointcloud",
        "doc": "pdal.las",
        "limit": 2
      },
      "expect": {
        "/result/points": 1,
        "/result/attributes": [
          "position",
          "intensity",
          "classification",
          "color",
          "returns",
          "time"
        ],
        "/result/bounds/min": [
          2,
          1,
          3
        ],
        "/result/bounds/max": [
          2,
          1,
          3
        ],
        "/result/selected/positions": [
          [
            2,
            1,
            3
          ]
        ],
        "/result/selected/intensity": [
          0
        ],
        "/result/selected/classification": [
          0
        ],
        "/result/selected/truncated": false
      }
    }
  ]
}
