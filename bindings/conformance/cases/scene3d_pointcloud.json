{
  "description": "自作の形式 2 の LAS（色・強度・分類を持つ 12 点。同じ位置を重ねて 3 段の節を作る）を点群のモジュールで開き、scene3d で八分木の節ごとの点の区画を持つ ZMS3 1.1 を得る。範囲と件数で絞り、不正な指定・予算停止の後にも再利用できる（#475）",
  "module": "pointcloud",
  "steps": [
    {
      "push": {
        "name": "c.las",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "c.las"
      },
      "expect": {
        "/result/format": "las"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las"
      },
      "expect": {
        "/result/unit/name": "METRE",
        "/result/map/crs_name": "EPSG:6677",
        "/result/height_crs": 6695,
        "/result/truncated": false,
        "/result/counts/points": 12,
        "/result/counts/chunks": 9,
        "/result/counts/meshes": 0,
        "/result/counts/elements": 0,
        "/result/extent/min": [
          1001,
          2002,
          0
        ],
        "/result/extent/max": [
          1002.5,
          2002.9,
          1
        ],
        "/blobs/0/kind": "scene3d"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "box": {
          "min": [
            1001.4,
            2002,
            0
          ],
          "max": [
            1003,
            2003,
            1
          ]
        }
      },
      "expect": {
        "/result/counts/points": 9,
        "/result/truncated": false,
        "/result/box/min": [
          1001.4,
          2002,
          0
        ]
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "limit": 5
      },
      "expect": {
        "/result/counts/points": 5,
        "/result/truncated": true
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "ids": []
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "classes": []
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "storeys": []
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "zone": 9
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "tolerance": 0
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "budget": {
          "work": 1
        }
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "budget": {
          "decoded_bytes": 1
        }
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "budget": {
          "elements": 1
        }
      },
      "status": "failed",
      "expect": {
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "c.las",
        "limit": 0
      },
      "expect": {
        "/result/counts/points": 0,
        "/result/counts/chunks": 0,
        "/result/truncated": true
      }
    },
    {
      "take": 0
    }
  ]
}
