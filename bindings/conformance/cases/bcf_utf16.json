{
  "description": "UTF-16LE/BE の BCF の部品を読み、未変更の topic は原本を保持する。未知の要素と属性を保てない変更保存は診断して止める。入力は自作の ZIP とレビューの文書",
  "module": "bim",
  "steps": [
    {
      "push": {
        "name": "same.json",
        "text": "{\"format\":\"zumen-review\",\"version\":1,\"targets\":[{\"id\":\"model\",\"format\":\"ifc\",\"hash\":\"v1:0\"}],\"topics\":[{\"id\":\"6e4a7c1c-1111-4c3b-9a3e-0f6c3a2b1d01\",\"title\":\"元の題\",\"status\":\"open\",\"kind\":\"Issue\",\"created\":\"2026-10-01T09:00:00Z\",\"author\":\"a\"}]}"
      }
    },
    {
      "push": {
        "name": "changed.json",
        "text": "{\"format\":\"zumen-review\",\"version\":1,\"targets\":[{\"id\":\"model\",\"format\":\"ifc\",\"hash\":\"v1:0\"}],\"topics\":[{\"id\":\"6e4a7c1c-1111-4c3b-9a3e-0f6c3a2b1d01\",\"title\":\"変更後\",\"status\":\"open\",\"kind\":\"Issue\",\"created\":\"2026-10-01T09:00:00Z\",\"author\":\"a\"}]}"
      }
    },
    {
      "push": {
        "name": "little.bcf",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_write",
        "review": "same.json",
        "original": "little.bcf",
        "target": "model"
      },
      "expect": {
        "/result/topics": 1,
        "/blobs/0/kind": "file",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_write",
        "review": "changed.json",
        "original": "little.bcf",
        "target": "model"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "bcf.encoding.unsupported",
        "/diagnostics/0/params/encoding": "UTF-16LE",
        "/diagnostics/0/params/topic": "6e4a7c1c-1111-4c3b-9a3e-0f6c3a2b1d01"
      }
    },
    {
      "push": {
        "name": "big.bcf",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_write",
        "review": "same.json",
        "original": "big.bcf",
        "target": "model"
      },
      "expect": {
        "/result/topics": 1,
        "/blobs/0/kind": "file",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_write",
        "review": "changed.json",
        "original": "big.bcf",
        "target": "model"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "bcf.encoding.unsupported",
        "/diagnostics/0/params/encoding": "UTF-16BE",
        "/diagnostics/0/params/topic": "6e4a7c1c-1111-4c3b-9a3e-0f6c3a2b1d01"
      }
    }
  ]
}
