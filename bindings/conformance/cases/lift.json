{
  "description": "lift は、開いた図面の文書を図面モデル（L2）にし、図面モデルのバイナリ（schema/drawing.toml の配置、決定 0246）を blob で返す。open は、図面モデルのバイナリを、元の文書の形式とハッシュのまま、読むだけの文書にする。違う大版と壊れたバイナリは断り、新しい小版の知らない欄と区画は読み飛ばす。バイナリが、ネイティブと wasm で同じバイト列になることを確かめる",
  "steps": [
    {
      "push": {
        "name": "a.dxf",
        "text": "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n5\nA1\n8\n0\n10\n0.0\n20\n0.0\n11\n10.0\n21\n5.0\n0\nCIRCLE\n5\nA2\n8\n0\n10\n3.0\n20\n4.0\n40\n2.0\n0\nENDSEC\n0\nEOF\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.dxf"
      },
      "expect": {
        "/result/format": "dxf"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.dxf"
      },
      "expect": {
        "/result/hash": "v2:b4e4edc3215dc11421a5eea00ce35a7d"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "lift",
        "doc": "a.dxf"
      },
      "expect": {
        "/result/blob": 0,
        "/blobs/0/kind": "drawing"
      }
    },
    {
      "take": 0
    },
    {
      "push": {
        "name": "lifted",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "lifted"
      },
      "expect": {
        "/result/format": "dxf"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "lifted"
      },
      "expect": {
        "/result/hash": "v2:b4e4edc3215dc11421a5eea00ce35a7d",
        "/result/spaces/0/elements/lines": 1
      }
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "lifted",
        "fields": [
          "id",
          "kind",
          "layer",
          "geometry"
        ]
      },
      "expect": {
        "/result/total": 2,
        "/result/items/1/geometry/radius": 2
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene",
        "doc": "lifted",
        "from": "space/0"
      },
      "expect": {
        "/result/counts/lines": 2,
        "/blobs/0/kind": "scene"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "lifted",
        "edits": []
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.document.unsupported"
      }
    },
    {
      "push": {
        "name": "cut",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "cut"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "drawing.binary.invalid"
      }
    },
    {
      "push": {
        "name": "major",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "major"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "drawing.binary-version.unsupported",
        "/diagnostics/0/params/major": 2
      }
    },
    {
      "push": {
        "name": "later",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "later"
      },
      "expect": {
        "/result/format": "dxf",
        "/diagnostics/0/code": "drawing.binary-section.dropped",
        "/diagnostics/1/code": "drawing.binary-field.dropped"
      }
    }
  ]
}
