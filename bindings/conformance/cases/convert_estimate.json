{
  "description": "変換の見積もりは、文書と blob を登録せず、明細の上限だけを変えられる。同名で実変換でき、SXF の図面モデルを経る経路と R2004 DWG の共有 L1 の経路で、応答・診断・出力のバイト列をネイティブと wasm で照合する。",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "input.sfc",
        "text": "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION(('SCADEC level2 feature_mode'),'2;1');\nFILE_SCHEMA(('ASSOCIATIVE_DRAUGHTING'));\nENDSEC;\nDATA;\n/*SXF3\n#10 = layer_feature(\\'L\\','1')\nSXF3*/\n/*SXF3\n#20 = line_feature('1','1','1','1','0.0','0.0','100.0','50.0')\nSXF3*/\n/*SXF3\n#30 = drawing_sheet_feature(\\'S\\','3','1','0','0')\nSXF3*/\nENDSEC;\nEND-ISO-10303-21;\n"
      }
    },
    {
      "call": { "v": 1, "op": "open", "input": "input.sfc" },
      "expect": { "/result/format": "sxf" }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input.sfc", "format": "dxf", "to": "out.dxf", "limit": 0 },
      "expect": {
        "/result/estimate/doc": "out.dxf",
        "/result/estimate/format": "dxf",
        "/result/estimate/elements": 1,
        "/result/estimate/details": [],
        "/result/estimate/truncated": true,
        "/result/estimate/input_diagnostics": { "total": 0, "counts": [], "details": [], "truncated": false },
        "/diagnostics": [],
        "/blobs": []
      },
      "absent": ["/result/doc"]
    },
    {
      "call": { "v": 1, "op": "drawing", "doc": "out.dxf" },
      "status": "failed",
      "expect": { "/diagnostics/0/code": "call.document.missing", "/blobs": [] }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input.sfc", "format": "dxf", "to": "out.dxf", "limit": 1 },
      "expect": { "/result/estimate/elements": 1, "/result/estimate/truncated": true, "/blobs": [] },
      "absent": ["/result/estimate/details/1"]
    },
    {
      "call": { "v": 1, "op": "convert", "doc": "input.sfc", "format": "dxf", "to": "out.dxf" },
      "expect": { "/result/doc": "out.dxf", "/result/elements": 1, "/diagnostics": [], "/blobs/0/kind": "file" }
    },
    { "take": 0 },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input.sfc", "format": "dxf", "to": "out.dxf" },
      "status": "failed",
      "expect": { "/diagnostics/0/code": "call.document.exists", "/blobs": [] }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input.sfc", "format": "sxf", "to": "out.sfc" },
      "status": "failed",
      "expect": { "/diagnostics/0/code": "convert.format.unsupported", "/blobs": [] }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input.sfc", "format": "dxf", "to": "retry.dxf", "budget": { "work": 1 } },
      "status": "failed",
      "expect": { "/diagnostics/0/code": "budget.work.exceeded", "/blobs": [] },
      "absent": ["/result"]
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input.sfc", "format": "dxf", "to": "retry.dxf", "limit": 0 },
      "expect": { "/result/estimate/elements": 1, "/blobs": [] }
    },
    {
      "push": { "name": "input.dwg", "file": "samples/dwg/zumen-arcdim-r2004.dwg" }
    },
    {
      "call": { "v": 1, "op": "open", "input": "input.dwg" },
      "expect": { "/result/format": "dwg" }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input.dwg", "format": "dxf", "to": "arcdim.dxf", "limit": 0, "max_places": 1 },
      "expect": {
        "/result/estimate/elements": 79,
        "/result/estimate/details": [],
        "/result/estimate/input_diagnostics": { "total": 0, "counts": [], "details": [], "truncated": false },
        "/result/estimate/truncated": true,
        "/diagnostics/0/code": "dwg.dxf-reference.dropped",
        "/diagnostics/0/count": 12,
        "/diagnostics/1/code": "dwg.dxf-reference.dropped",
        "/diagnostics/1/count": 12,
        "/blobs": []
      }
    },
    {
      "call": { "v": 1, "op": "convert", "doc": "input.dwg", "format": "dxf", "to": "arcdim.dxf", "max_places": 1 },
      "expect": { "/result/elements": 79, "/diagnostics/0/count": 12, "/diagnostics/1/count": 12, "/blobs/0/kind": "file" }
    },
    { "take": 0 },
    {
      "call": { "v": 1, "op": "entities", "doc": "input.dwg", "limit": 2 },
      "expect": { "/result/items/0/id": "space/0/h2D9", "/result/items/1/id": "space/0/h2DA", "/result/items/1/kind": "dimension" }
    },
    {
      "call": { "v": 1, "op": "entities", "doc": "arcdim.dxf", "limit": 2 },
      "expect": { "/result/items/0/id": "space/0/h2D9", "/result/items/1/id": "space/0/h2DA", "/result/items/1/kind": "dimension" }
    },
    {
      "push": {
        "name": "spline.dxf",
        "text": "0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1021\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nTABLES\n0\nTABLE\n2\nLAYER\n70\n1\n0\nLAYER\n2\n0\n70\n0\n62\n7\n6\nCONTINUOUS\n0\nENDTAB\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nSPLINE\n5\nA\n8\n0\n70\n1160\n71\n3\n72\n0\n73\n0\n74\n3\n44\n0.25\n11\n0\n21\n0\n31\n0\n11\n10\n21\n3\n31\n0\n11\n20\n21\n0\n31\n0\n0\nENDSEC\n0\nEOF\n"
      }
    },
    {
      "call": { "v": 1, "op": "open", "input": "spline.dxf" },
      "expect": { "/result/format": "dxf" }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "spline.dxf", "format": "dxf", "to": "spline-out.dxf", "limit": 1000 },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/counts/0/kind": "curve",
        "/result/estimate/counts/0/fidelity": "drawn",
        "/result/estimate/counts/0/count": 1,
        "/result/estimate/counts/0/output_elements": 1,
        "/blobs": []
      }
    },
    {
      "call": { "v": 1, "op": "convert", "doc": "spline.dxf", "format": "dxf", "to": "spline-out.dxf" },
      "expect": { "/result/elements": 1, "/blobs/0/kind": "file" }
    },
    { "take": 0 },
    {
      "push": {
        "name": "input-losses.dxf",
        "text": "0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1015\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n5\nA\n8\n0\n10\n0.0\n20\n0.0\n11\n1.0\n21\n0.0\n1000\norphan\n1001\nA\n1010\n1.0\n1020\n2.0\n1001\nB\n1002\n[\n1001\nC\n1099\nx\n1001\nE\n1099\ny\n1001\nD\n1070\n1\n0\nENDSEC\n0\nEOF\n"
      }
    },
    {
      "call": { "v": 1, "op": "open", "input": "input-losses.dxf" },
      "expect": { "/result/format": "dxf" }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input-losses.dxf", "format": "dxf", "to": "input-losses-out.dxf", "limit": 0, "max_places": 0 },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/input_diagnostics/total": 5,
        "/result/estimate/input_diagnostics/counts/0/code": "dxf.lift.invalid",
        "/result/estimate/input_diagnostics/counts/0/params/code": 1000,
        "/result/estimate/input_diagnostics/counts/0/at": [],
        "/result/estimate/input_diagnostics/counts/3/params/code": 1099,
        "/result/estimate/input_diagnostics/counts/3/count": 2,
        "/result/estimate/input_diagnostics/details": [],
        "/result/estimate/input_diagnostics/truncated": true,
        "/blobs": []
      },
      "absent": ["/result/estimate/input_diagnostics/counts/4"]
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input-losses.dxf", "format": "dxf", "to": "input-losses-out.dxf", "limit": 2, "max_places": 0 },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/input_diagnostics/total": 5,
        "/result/estimate/input_diagnostics/details/0/diagnostic/code": "dxf.lift.invalid",
        "/result/estimate/input_diagnostics/details/0/diagnostic/params/code": 1000,
        "/result/estimate/input_diagnostics/details/0/diagnostic/at/0/record": 3,
        "/result/estimate/input_diagnostics/details/0/sources/0/record": 3,
        "/result/estimate/input_diagnostics/details/0/sources/0/handle": "A",
        "/result/estimate/input_diagnostics/details/1/diagnostic/params/code": 1030,
        "/result/estimate/input_diagnostics/details/1/sources/0/handle": "A",
        "/result/estimate/input_diagnostics/truncated": true,
        "/blobs": []
      },
      "absent": ["/result/estimate/input_diagnostics/details/2"]
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "input-losses.dxf", "format": "dxf", "to": "input-losses-out.dxf", "limit": 1000, "max_places": 0 },
      "expect": {
        "/result/estimate/input_diagnostics/total": 5,
        "/result/estimate/input_diagnostics/details/3/diagnostic/params/code": 1099,
        "/result/estimate/input_diagnostics/details/3/diagnostic/count": 1,
        "/result/estimate/input_diagnostics/details/3/sources/0/handle": "A",
        "/result/estimate/input_diagnostics/details/4/diagnostic/params/code": 1099,
        "/result/estimate/input_diagnostics/details/4/diagnostic/count": 1,
        "/result/estimate/input_diagnostics/details/4/sources/0/handle": "A",
        "/result/estimate/input_diagnostics/truncated": false,
        "/blobs": []
      },
      "absent": ["/result/estimate/input_diagnostics/details/5"]
    },
    {
      "call": { "v": 1, "op": "convert", "doc": "input-losses.dxf", "format": "dxf", "to": "input-losses-out.dxf", "max_places": 0 },
      "expect": { "/result/elements": 1, "/diagnostics/0/code": "dxf.lift.invalid", "/diagnostics/0/at": [], "/blobs/0/kind": "file" }
    },
    { "take": 0 },
    {
      "push": {
        "name": "unknown-unit.dxf",
        "text": "0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1015\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n5\nA\n8\n0\n10\n0.0\n20\n0.0\n11\n1.0\n21\n0.0\n0\nENDSEC\n0\nEOF\n"
      }
    },
    {
      "call": { "v": 1, "op": "open", "input": "unknown-unit.dxf" },
      "expect": { "/result/format": "dxf" }
    },
    {
      "call": { "v": 1, "op": "convert_estimate", "doc": "unknown-unit.dxf", "format": "dxf", "to": "unknown-unit-out.dxf", "limit": 1, "max_places": 0 },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/input_diagnostics/total": 1,
        "/result/estimate/input_diagnostics/counts/0/code": "dxf.units.missing",
        "/result/estimate/input_diagnostics/counts/0/at": [],
        "/result/estimate/input_diagnostics/details/0/diagnostic/code": "dxf.units.missing",
        "/result/estimate/input_diagnostics/details/0/diagnostic/at": [],
        "/result/estimate/input_diagnostics/details/0/sources": [],
        "/result/estimate/input_diagnostics/truncated": false,
        "/blobs": []
      },
      "absent": ["/result/estimate/input_diagnostics/details/0/diagnostic/fidelity", "/result/estimate/input_diagnostics/details/0/diagnostic/params/kind", "/result/estimate/input_diagnostics/details/1"]
    },
    {
      "push": {
        "name": "input-losses.p21",
        "text": "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION(('SCADEC level2 AP202_mode'),'2;1');\nFILE_SCHEMA(('ASSOCIATIVE_DRAUGHTING'));\nENDSEC;\nDATA;\n#1=PRESENTATION_STYLE_ASSIGNMENT(());\n#2=CARTESIAN_POINT(' ',(1.,2.));\n#3=CARTESIAN_POINT(' ',(4.,6.));\n#4=POLYLINE(' ',(#2,#3));\n#5=ANNOTATION_CURVE_OCCURRENCE(' ',(#1),#4);\n#110=ANNOTATION_CURVE_OCCURRENCE(' ',(#1),#999);\n#20=PRESENTATION_LAYER_ASSIGNMENT('L',' ',(#5,#110));\n#70=DRAWING_SHEET_REVISION('A3_horizontal',(#110,#5),$,'01');\nENDSEC;\nEND-ISO-10303-21;\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "input-losses.p21"
      },
      "expect": {
        "/result/format": "sxf"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert_estimate",
        "limit": 0,
        "doc": "input-losses.p21",
        "format": "dxf",
        "to": "p21-losses-out.dxf",
        "max_places": 0
      },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/input_diagnostics/total": 2,
        "/result/estimate/input_diagnostics/details": [],
        "/result/estimate/input_diagnostics/truncated": true,
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert_estimate",
        "limit": 1000,
        "doc": "input-losses.p21",
        "format": "dxf",
        "to": "p21-losses-out.dxf",
        "max_places": 0
      },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/input_diagnostics/total": 2,
        "/result/estimate/input_diagnostics/details/0/diagnostic/code": "sxf.p21-reference.missing",
        "/result/estimate/input_diagnostics/details/0/diagnostic/params/id": 999,
        "/result/estimate/input_diagnostics/details/1/diagnostic/code": "sxf.lift.dropped",
        "/result/estimate/input_diagnostics/details/1/diagnostic/params/kind": "annotation_curve_occurrence",
        "/result/estimate/input_diagnostics/details/1/sources/0/instance": "110",
        "/result/estimate/input_diagnostics/truncated": false,
        "/blobs": []
      },
      "absent": [
        "/result/estimate/input_diagnostics/details/0/diagnostic/fidelity",
        "/result/estimate/input_diagnostics/details/2"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "input-losses.p21",
        "format": "dxf",
        "to": "p21-losses-out.dxf",
        "max_places": 0
      },
      "expect": {
        "/result/elements": 1,
        "/diagnostics/0/code": "sxf.p21-reference.missing",
        "/diagnostics/0/at": [],
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "push": {
        "name": "input-losses.jww",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "input-losses.jww"
      },
      "expect": {
        "/result/format": "jww"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert_estimate",
        "limit": 0,
        "doc": "input-losses.jww",
        "format": "dxf",
        "to": "jww-losses-out.dxf",
        "max_places": 0
      },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/input_diagnostics/total": 1,
        "/result/estimate/input_diagnostics/counts/0/code": "jww.lift.invalid",
        "/result/estimate/input_diagnostics/counts/0/at": [],
        "/result/estimate/input_diagnostics/details": [],
        "/result/estimate/input_diagnostics/truncated": true,
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert_estimate",
        "limit": 1,
        "doc": "input-losses.jww",
        "format": "dxf",
        "to": "jww-losses-out.dxf",
        "max_places": 0
      },
      "expect": {
        "/result/estimate/elements": 1,
        "/result/estimate/input_diagnostics/total": 1,
        "/result/estimate/input_diagnostics/details/0/diagnostic/code": "jww.lift.invalid",
        "/result/estimate/input_diagnostics/details/0/diagnostic/params/kind": "CDataSen",
        "/result/estimate/input_diagnostics/details/0/diagnostic/count": 1,
        "/result/estimate/input_diagnostics/details/0/diagnostic/at/0/record": 1,
        "/result/estimate/input_diagnostics/details/0/sources/0/record": 1,
        "/result/estimate/input_diagnostics/truncated": false,
        "/blobs": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "input-losses.jww",
        "format": "dxf",
        "to": "jww-losses-out.dxf",
        "max_places": 0
      },
      "expect": {
        "/result/elements": 1,
        "/diagnostics/0/code": "convert.element.unsupported",
        "/diagnostics/0/params/kind": "line_type",
        "/diagnostics/0/at": [],
        "/diagnostics/1/code": "jww.lift.invalid",
        "/diagnostics/1/params/kind": "CDataSen",
        "/diagnostics/1/count": 1,
        "/diagnostics/1/at": [],
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    }
  ]
}
