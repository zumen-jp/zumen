{
  "description": "P21 の Shift_JIS のレイヤ「図枠」（90 7D 98 67）に点を 2 つ足しても、元の線と追加した点が同じ名前のレイヤに入る。書き戻したファイルのバイト列もネイティブと wasm で一致する（#552）",
  "steps": [
    {
      "push": {
        "name": "raw-layer.p21",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "raw-layer.p21"
      },
      "expect": {
        "/result/format": "sxf",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "raw-layer.p21",
        "fields": [
          "id",
          "kind",
          "layer",
          "geometry"
        ]
      },
      "expect": {
        "/result/total": 1,
        "/result/items/0/id": "sheet/0/i18",
        "/result/items/0/layer": "図枠",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "raw-layer.p21",
        "edits": [
          {
            "kind": "add",
            "place": "sheet/0",
            "layer": "図枠",
            "color": {
              "sxf": 2
            },
            "geometry": {
              "shape": "point",
              "position": [
                50,
                60
              ],
              "rotation": 30,
              "marker": {
                "namespace": "sxf.marker",
                "code": "1",
                "scale": 1
              }
            }
          },
          {
            "kind": "add",
            "place": "sheet/0",
            "layer": "図枠",
            "color": {
              "sxf": 2
            },
            "geometry": {
              "shape": "point",
              "position": [
                80,
                60
              ],
              "rotation": 0,
              "marker": {
                "namespace": "sxf.marker",
                "code": "3",
                "scale": 1
              }
            }
          }
        ]
      },
      "expect": {
        "/diagnostics": [],
        "/blobs/0/kind": "file",
        "/result/applied/0/id": "sheet/0/i42",
        "/result/applied/1/id": "sheet/0/i52"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "raw-layer.p21",
        "fields": [
          "id",
          "kind",
          "layer",
          "geometry"
        ]
      },
      "expect": {
        "/result/total": 3,
        "/result/items/0/id": "sheet/0/i18",
        "/result/items/0/layer": "図枠",
        "/result/items/1/id": "sheet/0/i42",
        "/result/items/1/kind": "point",
        "/result/items/1/layer": "図枠",
        "/result/items/1/geometry/position": [
          50,
          60
        ],
        "/result/items/2/id": "sheet/0/i52",
        "/result/items/2/kind": "point",
        "/result/items/2/layer": "図枠",
        "/result/items/2/geometry/position": [
          80,
          60
        ],
        "/diagnostics": []
      }
    }
  ]
}
