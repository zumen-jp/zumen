        "op": "entities",
        "doc": "plan.dxf",
        "budget": {
          "model_bytes": 2911
        }
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "budget.model-bytes.exceeded",
        "/diagnostics/0/params/limit": 2911,
        "/diagnostics/0/params/requested": 2912,
        "/blobs": []
      },
      "absent": [
        "/result"
      ]
    },
    {
      "call": {
