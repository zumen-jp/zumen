{
  "description": "自作 Shift_JIS CityGML の日本語の型と属性名を返し、main b8c101e1 由来の fallback ID を保つ（#824）",
  "module": "civil",
  "steps": [
    {
      "push": {
        "name": "names.gml",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "names.gml"
      },
      "expect": {
        "/result/format": "citygml",
        "/diagnostics/0/code": "citygml.crs.unsupported"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "geo",
        "doc": "names.gml"
      },
      "expect": {
        "/result/features": 1,
        "/result/kinds": [
          {
            "kind": "ソ:Thing",
            "count": 1
          }
        ]
      }
    },
    {
      "call": {
        "v": 1,
        "op": "geo",
        "doc": "names.gml",
        "id": "�\\:Thing/0"
      },
      "expect": {
        "/result/feature/id": "�\\:Thing/0",
        "/result/feature/kind": "ソ:Thing",
        "/result/feature/attributes/0/name": "ソ:注記",
        "/result/feature/attributes/0/value": "value"
      }
    }
  ]
}
