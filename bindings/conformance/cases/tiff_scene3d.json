{
  "module": "pointcloud",
  "description": "平面直角座標系の GeoTIFF の DEM（単バンドの標高格子）の scene3d は、外枠の地物でなく標高格子を、点群の scene3d と同じ点の区画（ZMS3 1.1）で返す（#896）。座標系と高さの基準は変換しない。GDAL_NODATA と非有限値のセルは点に含めず、理由ごとのセルの数を tiff.cell.dropped で知らせる",
  "steps": [
    {
      "push": {
        "name": "dem.tif",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "dem.tif"
      },
      "expect": {
        "/result/format": "tiff"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif"
      },
      "expect": {
        "/result/counts/points": 4,
        "/result/map/crs_name": "EPSG:6677",
        "/result/height_crs": 6695,
        "/result/truncated": false,
        "/result/extent/min": [
          200.5,
          98.5,
          10.5
        ],
        "/result/extent/max": [
          201.5,
          99.5,
          12
        ],
        "/blobs/0/kind": "scene3d"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif",
        "limit": 2
      },
      "expect": {
        "/result/counts/points": 2,
        "/result/truncated": true
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif",
        "box": {
          "min": [
            200,
            98,
            0
          ],
          "max": [
            200.75,
            98.75,
            20
          ]
        }
      },
      "expect": {
        "/result/counts/points": 1
      }
    },
    {
      "take": 0
    },
    {
      "push": {
        "name": "holes.tif",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "holes.tif"
      },
      "expect": {
        "/result/format": "tiff"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "holes.tif"
      },
      "expect": {
        "/result/counts/points": 4,
        "/diagnostics/0/code": "tiff.cell.dropped",
        "/diagnostics/0/params/reason": "nodata",
        "/diagnostics/0/params/cells": 1,
        "/diagnostics/1/code": "tiff.cell.dropped",
        "/diagnostics/1/params/reason": "non-finite",
        "/diagnostics/1/params/cells": 1
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif",
        "lod": 1
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/params/pointer": "/lod"
      }
    }
  ]
}
