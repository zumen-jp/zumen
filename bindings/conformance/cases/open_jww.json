{
  "description": "open は、JWW の判定の規則に合う入力を JWW のコーデックで読む。見出しが途中で切れた入力は、診断を返して失敗する。drawing は、図形を置いたレイヤグループごとの実寸の空間と、縮尺の逆数で用紙に置くビューにする（決定 0133・0134）。入力は試験の中で作る合成の JWW の版 700 で、縮尺 1/100 のグループ 0 に線分を 1 つと、A3 の用紙を持つ",
  "steps": [
    {
      "push": {
        "name": "a.jww",
        "hex": ""
      }
    },
    {
      "push": {
        "name": "b.jww",
        "hex": "4a7777446174612ee7030000"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.jww"
      },
      "expect": {
        "/result": {
          "doc": "a.jww",
          "format": "jww"
        },
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.jww"
      },
      "expect": {
        "/result": {
          "hash": "v1:090650757795390b0109c04ee7d5840d",
          "spaces": [
            {
              "id": "space/0",
              "unit": "millimeter",
              "elements": {
                "lines": 1,
                "texts": 0
              },
              "extent": {
                "min_x": 0,
                "min_y": 0,
                "max_x": 10000,
                "max_y": 5000
              }
            }
          ],
          "sheets": [
            {
              "id": "sheet/0",
              "size": [
                420,
                297
              ],
              "elements": {
                "lines": 0,
                "texts": 0
              },
              "views": 1
            }
          ]
        },
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "b.jww"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "jww.body.invalid"
      },
      "absent": [
        "/result"
      ]
    }
  ]
}
