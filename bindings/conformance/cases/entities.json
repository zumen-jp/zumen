    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "a.dxf"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.document.missing",
        "/diagnostics/0/params/name": "a.dxf"
      },
      "absent": [
        "/result"
      ]
    },
    {
      "push": {
        "name": "a.dxf",
