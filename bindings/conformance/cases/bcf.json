{
  "description": "bcf_read は BCF 3.0 の bcfzip を、開いた IFC を対象にしたレビューの文書にし、要素の参照のハッシュを建物モデルで埋める。TopicStatus は statuses の表で状態に写し、表にない文字列は open と status_label にする。bcf_write はレビューの文書を bcfzip に書き、種類・作者・日時のない指摘には要求の値を書き、値がなければ失敗する。3.0 でない bcfzip は読まない（決定 0220）。入力は試験の中で書いた小さな IFC4 と bcfzip と、レビューの文書",
  "steps": [
    {
      "push": {
        "name": "a.ifc",
        "text": "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION((''),'2;1');\nFILE_NAME('','',(''),(''),'','','');\nFILE_SCHEMA(('IFC4'));\nENDSEC;\nDATA;\n#1=IFCPROJECT('0000000000000000000001',$,'Project',$,$,$,$,$,#10);\n#10=IFCUNITASSIGNMENT((#11));\n#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);\n#20=IFCLOCALPLACEMENT($,#21);\n#21=IFCAXIS2PLACEMENT3D(#22,$,$);\n#22=IFCCARTESIANPOINT((0.,0.,3000.));\n#34=IFCBUILDINGSTOREY('0000000000000000000034',$,'1F',$,$,#20,$,$,.ELEMENT.,3000.);\n#40=IFCRELAGGREGATES('0000000000000000000040',$,$,$,#1,(#34));\n#60=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000060',$,$,$,(#80),#34);\n#61=IFCRELDEFINESBYPROPERTIES('0000000000000000000061',$,$,$,(#80),#62);\n#62=IFCPROPERTYSET('0000000000000000000062',$,'Pset_DoorCommon',$,(#63));\n#63=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.T.),$);\n#80=IFCDOOR('0000000000000000000080',$,'Door',$,$,$,$,'D-1',2100.,$,.DOOR.,$,$);\nENDSEC;\nEND-ISO-10303-21;\n"
      }
    },
    {
      "push": {
        "name": "a.bcf",
        "hex": ""
      }
    },
    {
      "push": {
        "name": "old.bcf",
        "hex": ""
      }
    },
    {
      "push": {
        "name": "new.json",
        "text": "{\"format\": \"zumen-review\", \"version\": 1, \"targets\": [{\"id\": \"model\", \"format\": \"ifc\", \"hash\": \"v1:0\", \"name\": \"a.ifc\"}], \"topics\": [{\"id\": \"t-1\", \"title\": \"新しい指摘\", \"status\": \"open\", \"locations\": [{\"id\": \"t-1/l1\", \"target\": \"model\", \"kind\": \"3d\", \"selected\": [{\"id\": \"0000000000000000000080\"}], \"camera\": {\"projection\": \"perspective\", \"field_of_view\": 60, \"position\": [0, 0, 0], \"direction\": [1, 0, 0], \"up\": [0, 0, 1]}}]}]}"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.ifc"
      },
      "expect": {
        "/result/format": "ifc"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_read",
        "doc": "a.ifc",
        "input": "a.bcf",
        "target": "model",
        "statuses": [
          {
            "text": "Done",
            "status": "resolved"
          }
        ]
      },
      "expect": {
        "/result/version": "3.0",
        "/result/topics": 1,
        "/blobs/0/kind": "file"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_read",
        "doc": "a.ifc",
        "input": "a.bcf",
        "target": "model"
      },
      "expect": {
        "/result/topics": 1
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_read",
        "doc": "a.ifc",
        "input": "old.bcf",
        "target": "model"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "bcf.version.unsupported",
        "/diagnostics/0/params/version": "2.1"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_write",
        "review": "new.json",
        "target": "model",
        "kind": "Issue",
        "author": "a",
        "date": "2026-10-01T09:00:00Z"
      },
      "expect": {
        "/result/topics": 1,
        "/blobs/0/kind": "file",
        "/diagnostics/0/code": "bcf.value.assumed"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_write",
        "review": "new.json",
        "target": "model"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "bcf.value.missing"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "bcf_write",
        "review": "new.json",
        "target": "model",
        "original": "old.bcf",
        "kind": "Issue",
        "author": "a",
        "date": "2026-10-01T09:00:00Z"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "bcf.version.unsupported"
      }
    }
  ]
}
