{
  "description": "open は、TIFF 6.0 と OGC GeoTIFF 1.1（#877）を先頭の署名から判定して開き、図面（drawing・tables・scene）・画像復号（raster）・地理（geo）・点群（pointcloud・deviation）の各操作に応える。GeoTIFF から GeoJSON・DXF・SIMA への変換も行う。",
  "module": "all",
  "steps": [
    {
      "push": {
        "name": "scan.tif",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "scan.tif"
      },
      "expect": {
        "/result/format": "tiff"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "scan.tif"
      },
      "expect": {
        "/result/spaces/0/id": "space/0",
        "/result/spaces/1/id": "space/1"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "raster",
        "doc": "scan.tif",
        "page": 1,
        "max_side": 2
      },
      "expect": {
        "/result/width": 2,
        "/result/height": 1,
        "/result/source_width": 4,
        "/result/source_height": 2,
        "/result/page": 1,
        "/result/pages": 2,
        "/blobs/0/kind": "image"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "raster",
        "doc": "scan.tif",
        "page": 2
      },
      "expect": {
        "/result/width": 2,
        "/result/height": 2,
        "/result/page": 2,
        "/result/pages": 2,
        "/blobs/0/kind": "image"
      }
    },
    {
      "take": 0
    },
    {
      "push": {
        "name": "dem.tif",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "dem.tif"
      },
      "expect": {
        "/result/format": "tiff"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "dem.tif"
      },
      "expect": {
        "/result/spaces/0/unit": "meter"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "geo",
        "doc": "dem.tif"
      },
      "expect": {
        "/result/crs": 6677,
        "/result/height": 6695,
        "/result/features": 1
      }
    },
    {
      "call": {
        "v": 1,
        "op": "pointcloud",
        "doc": "dem.tif"
      },
      "expect": {
        "/result/crs": 6677,
        "/result/vertical": 6695,
        "/result/points": 3
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "dem.tif",
        "format": "geojson",
        "to": "dem.geojson"
      },
      "expect": {
        "/result/format": "geojson",
        "/result/elements": 1,
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "dem.tif",
        "format": "dxf",
        "to": "dem.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "dem.tif",
        "format": "sima",
        "to": "dem.sim"
      },
      "expect": {
        "/result/format": "sima",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    }
  ]
}
