{
  "module": "pointcloud",
  "description": "平面直角座標系の GeoTIFF の DEM の scene3d に surface を渡すと、標高格子を点でなく地形の面（セル代表点を頂点にした三角形）で返す（#896）。区画ごとの要素は dem のクラスで、座標系と高さの基準は変換しない。tolerance はセルの間隔の整数倍に間引き、limit を超えれば間隔を広げ、それでも超えれば面を返さない。nodata と非有限値のセルは面に含めない。",
  "steps": [
    {
      "push": {
        "name": "dem.tif",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "dem.tif"
      },
      "expect": {
        "/result/format": "tiff"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif",
        "surface": true
      },
      "expect": {
        "/result/counts/vertices": 4,
        "/result/counts/triangles": 2,
        "/result/counts/elements": 1,
        "/result/counts/chunks": 1,
        "/result/counts/edges": 0,
        "/result/map/crs_name": "EPSG:6677",
        "/result/height_crs": 6695,
        "/result/tolerance": 1,
        "/result/truncated": false,
        "/result/extent/min": [
          200.5,
          98.5,
          10.5
        ],
        "/result/extent/max": [
          201.5,
          99.5,
          12
        ],
        "/blobs/0/kind": "scene3d"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif",
        "surface": true,
        "box": {
          "min": [
            300,
            300,
            0
          ],
          "max": [
            400,
            400,
            20
          ]
        }
      },
      "expect": {
        "/result/counts/elements": 0,
        "/result/truncated": false
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif",
        "surface": true,
        "limit": 3
      },
      "expect": {
        "/result/truncated": true,
        "/result/counts/elements": 0,
        "/result/counts/triangles": 0
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "dem.tif",
        "surface": false,
        "limit": 2
      },
      "expect": {
        "/result/counts/points": 2,
        "/result/truncated": true
      }
    },
    {
      "take": 0
    },
    {
      "push": {
        "name": "holes.tif",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "holes.tif"
      },
      "expect": {
        "/result/format": "tiff"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "scene3d",
        "doc": "holes.tif",
        "surface": true
      },
      "expect": {
        "/result/counts/vertices": 3,
        "/result/counts/triangles": 1,
        "/result/counts/elements": 1,
        "/diagnostics/0/code": "tiff.cell.dropped",
        "/diagnostics/0/params/reason": "nodata",
        "/diagnostics/1/code": "tiff.cell.dropped",
        "/diagnostics/1/params/reason": "non-finite"
      }
    },
    {
      "take": 0
    }
  ]
}