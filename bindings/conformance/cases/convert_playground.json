{
  "description": "プレイグラウンドの「DXF で保存」（#690）で変換する入力を、convert で DXF にする。書いた DXF の SHA-256（ハッシュの一覧の blob の行）を、ブラウザーの検査（`bindings/js/test/browser/react.mjs`）が保存したファイルと比べ、ネイティブと wasm とブラウザーで同じバイト列になることを確かめる。入力は `open_dwg.json` の合成の DWG、`open_jww.json` の JWW、`open_sxf.json` の SFC と P21、公開サンプルの DWG（R2000・R2004・R2018）",
  "steps": [
    {
      "push": {
        "name": "a.dwg",
        "hex": ""
      }
    },
    {
      "push": {
        "name": "a.jww",
        "hex": ""
      }
    },
    {
      "push": {
        "name": "a.sfc",
        "text": "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION(('SCADEC level2 feature_mode'),'2;1');\nFILE_SCHEMA(('ASSOCIATIVE_DRAUGHTING'));\nENDSEC;\nDATA;\n/*SXF3\n#10 = layer_feature(\\'L\\','1')\nSXF3*/\n/*SXF3\n#20 = line_feature('1','1','1','1','0.0','0.0','100.0','50.0')\nSXF3*/\n/*SXF3\n#30 = drawing_sheet_feature(\\'S\\','3','1','0','0')\nSXF3*/\nENDSEC;\nEND-ISO-10303-21;\n"
      }
    },
    {
      "push": {
        "name": "c.p21",
        "text": "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION(('SCADEC level2 AP202_mode'),'2;1');\nFILE_SCHEMA(('ASSOCIATIVE_DRAUGHTING'));\nENDSEC;\nDATA;\n#1=DRAUGHTING_PRE_DEFINED_COLOUR('black');\n#2=DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');\n#3=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));\n#4=LENGTH_MEASURE_WITH_UNIT(POSITIVE_LENGTH_MEASURE(0.13),#3);\n#5=CURVE_STYLE(' ',#2,#4,#1);\n#6=PRESENTATION_STYLE_ASSIGNMENT((#5));\n#10=CARTESIAN_POINT(' ',(0.,0.));\n#11=CARTESIAN_POINT(' ',(100.,50.));\n#14=DIRECTION(' ',(2.,1.));\n#15=VECTOR(' ',#14,1.);\n#16=LINE(' ',#10,#15);\n#17=TRIMMED_CURVE(' ',#16,(#10),(#11),.T.,.CARTESIAN.);\n#18=ANNOTATION_CURVE_OCCURRENCE(' ',(#6),#17);\n#20=PRESENTATION_LAYER_ASSIGNMENT('L',' ',(#18));\n#30=DRAWING_SHEET_REVISION('A3_horizontal',(#18),$,'01');\n#31=DRAUGHTING_TITLE((),'JAPANESE','S');\nENDSEC;\nEND-ISO-10303-21;\n"
      }
    },
    {
      "push": {
        "name": "zumen-layout-r2000.dwg",
        "file": "samples/dwg/zumen-layout-r2000.dwg"
      }
    },
    {
      "push": {
        "name": "zumen-minsert-r2004.dwg",
        "file": "samples/dwg/zumen-minsert-r2004.dwg"
      }
    },
    {
      "push": {
        "name": "zumen-xclip-r2018.dwg",
        "file": "samples/dwg/zumen-xclip-r2018.dwg"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.dwg"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "a.dwg",
        "format": "dxf",
        "to": "a.dwg.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.jww"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "a.jww",
        "format": "dxf",
        "to": "a.jww.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.sfc"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "a.sfc",
        "format": "dxf",
        "to": "a.sfc.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "c.p21"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "c.p21",
        "format": "dxf",
        "to": "c.p21.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "zumen-layout-r2000.dwg"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "zumen-layout-r2000.dwg",
        "format": "dxf",
        "to": "zumen-layout-r2000.dwg.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "zumen-minsert-r2004.dwg"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "zumen-minsert-r2004.dwg",
        "format": "dxf",
        "to": "zumen-minsert-r2004.dwg.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "zumen-xclip-r2018.dwg"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "convert",
        "doc": "zumen-xclip-r2018.dwg",
        "format": "dxf",
        "to": "zumen-xclip-r2018.dwg.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/blobs/0/kind": "file"
      }
    },
    {
      "take": 0
    }
  ]
}
