{
  "description": "delivery_check は、電子納品の成果品（決定 0241、#383）を、root の下の入力の名前の集まりか、ZIP の入力で受けて読み、管理ファイル（起点と直下のフォルダーの .XML）の DTD の名前・記録の数と、管理ファイルが指すが成果品にないファイルの名前を返す。管理ファイルは Shift_JIS でも読み、DTD は処理しない。照合の種類はまだない（#384）。",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "納品/INDEX_C.XML",
        "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE constdata SYSTEM \"INDE_C05.DTD\">\n<constdata DTD_version=\"05\"><基礎情報><図面フォルダ名>DRAWING</図面フォルダ名></基礎情報></constdata>\n"
      }
    },
    {
      "push": {
        "name": "納品/DRAWING/DRAWING.XML",
        "hex": ""
      }
    },
    {
      "push": {
        "name": "納品/DRAWING/D0PL001Z.P21",
        "text": "ISO-10303-21;"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "delivery_check",
        "root": "納品/"
      },
      "expect": {
        "/result/files": 3,
        "/result/managed/0": {
          "name": "DRAWING/DRAWING.XML",
          "doctype": "DRAW05.DTD",
          "root": "drawingdata",
          "records": 5,
          "links": 2,
          "missing": [
            "DRAWING/D0PL002Z.P21"
          ]
        },
        "/result/managed/1/name": "INDEX_C.XML",
        "/result/managed/1/doctype": "INDE_C05.DTD",
        "/result/chain": [],
        "/result/total": 0,
        "/diagnostics": []
      }
    },
    {
      "push": {
        "name": "納品.zip",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "delivery_check",
        "archive": "納品.zip"
      },
      "expect": {
        "/result/files": 3,
        "/result/managed/0/missing": [
          "DRAWING/D0PL002Z.P21"
        ]
      }
    },
    {
      "call": {
        "v": 1,
        "op": "delivery_check",
        "root": "なし/"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.value.invalid",
        "/diagnostics/0/params/pointer": "/root"
      }
    }
  ]
}
