{
  "description": "review_adopt は、check と同じに照合し、選んだ指摘だけを開いた指摘としてレビューの文書に足し、文書を blobs で返す。review_carry は、レビューの文書の対象を開いた文書の版へ移し、要素の参照ごとに unchanged・changed・removed を返す（決定 0214・0218）。結果が、ネイティブと wasm で同じになることを確かめる",
  "steps": [
    {
      "push": {
        "name": "a.dxf",
        "text": "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n5\nA1\n8\nC-STR\n62\n1\n6\nCONTINUOUS\n370\n35\n10\n0.0\n20\n0.0\n11\n10.0\n21\n0.0\n0\nLINE\n5\nA2\n8\nBAD\n62\n3\n6\nDASHED\n370\n30\n10\n0.0\n20\n1.0\n11\n10.0\n21\n1.0\n0\nTEXT\n5\nA3\n8\nC-STR\n62\n1\n10\n0.0\n20\n5.0\n40\n2.5\n1\nABC\n0\nENDSEC\n0\nEOF\n"
      }
    },
    {
      "push": {
        "name": "base.json",
        "text": "{\"format\":\"0.1\",\"id\":\"base\",\"edition\":\"2025-12\",\"revision\":1,\"vocabularies\":{\"who\":{\"values\":[{\"code\":\"C\"},{\"code\":\"D\"}]},\"what\":{\"values\":[{\"code\":\"STR\"}]},\"color\":{\"values\":[{\"name\":\"赤\",\"rgb\":\"#ff0000\",\"sxf\":2}]},\"line-type\":{\"values\":[{\"name\":\"実線\",\"sxf\":\"continuous\",\"acad\":\"CONTINUOUS\"}]},\"width\":{\"values\":[0.13,0.18,0.25,0.35,0.5]},\"height\":{\"values\":[2.5,3.5]},\"letters\":{\"values\":[\"41\"]}},\"rules\":[{\"id\":\"layer-name\",\"check\":\"layer-name\",\"level\":\"error\",\"parts\":[\"who\",\"what\"],\"user-part\":true,\"separator\":\"-\",\"max-width\":256},{\"id\":\"color\",\"check\":\"color\",\"level\":\"warning\",\"vocabulary\":\"color\"},{\"id\":\"line-type\",\"check\":\"line-type\",\"level\":\"warning\",\"vocabulary\":\"line-type\"},{\"id\":\"line-width\",\"check\":\"line-width\",\"level\":\"warning\",\"vocabulary\":\"width\"},{\"id\":\"text-height\",\"check\":\"text-height\",\"level\":\"warning\",\"vocabulary\":\"height\"},{\"id\":\"characters\",\"check\":\"characters\",\"level\":\"warning\",\"vocabulary\":\"letters\"}]}"
      }
    },
    {
      "push": {
        "name": "office.json",
        "text": "{\"format\":\"0.1\",\"id\":\"office\",\"edition\":\"1\",\"revision\":2,\"extends\":{\"id\":\"base\",\"edition\":\"2025-12\"},\"rules\":[{\"id\":\"color\",\"check\":\"color\",\"level\":\"error\",\"vocabulary\":\"color\"}]}"
      }
    },
    {
      "push": {
        "name": "palette.json",
        "text": "{\"values\":[{\"name\":\"赤\",\"rgb\":\"#ff0000\",\"aci\":1}]}"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.dxf"
      },
      "expect": {
        "/result/format": "dxf"
      }
    },
    {
      "push": {
        "name": "review.json",
        "text": "{\"format\":\"zumen-review\",\"version\":1,\"targets\":[{\"id\":\"plan\",\"format\":\"dxf\",\"hash\":\"v2:00000000000000000000000000000000\"}],\"topics\":[{\"id\":\"00000000-0000-8000-8000-000000000001\",\"title\":\"線の色\",\"status\":\"open\",\"locations\":[{\"id\":\"l1\",\"target\":\"plan\",\"kind\":\"2d\",\"pin\":[5,0],\"elements\":[{\"id\":\"space/0/hA1\",\"hash\":\"v2:00000000000000000000000000000000\"},{\"id\":\"space/0/hFF\",\"hash\":\"v2:00000000000000000000000000000000\"}]}],\"x_app\":{\"kept\":true}}],\"markups\":[{\"id\":\"m1\",\"kind\":\"cloud\",\"target\":\"plan\",\"points\":[[0,0],[10,1]],\"topic\":\"00000000-0000-8000-8000-000000000001\"}]}"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "review_adopt",
        "doc": "a.dxf",
        "profiles": [
          "base.json",
          "office.json"
        ],
        "profile": {
          "id": "office",
          "edition": "1"
        },
        "palette": "palette.json",
        "target": "plan",
        "findings": [
          0,
          3
        ]
      },
      "expect": {
        "/result/topics": 2,
        "/blobs/0/kind": "file"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "review_adopt",
        "doc": "a.dxf",
        "profiles": [
          "base.json",
          "office.json"
        ],
        "profile": {
          "id": "office",
          "edition": "1"
        },
        "palette": "palette.json",
        "review": "review.json",
        "target": "plan",
        "findings": [
          0
        ]
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "review.target.stale"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "review_carry",
        "doc": "a.dxf",
        "review": "review.json",
        "target": "plan"
      },
      "expect": {
        "/result/from": "v2:00000000000000000000000000000000",
        "/result/total": 2,
        "/result/references/0": {
          "topic": "00000000-0000-8000-8000-000000000001",
          "location": "l1",
          "element": "space/0/hA1",
          "state": "changed"
        },
        "/result/references/1/state": "removed",
        "/blobs/0/kind": "file",
        "/diagnostics": []
      },
      "absent": [
        "/result/next_offset"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "review_carry",
        "doc": "a.dxf",
        "review": "review.json",
        "target": "plan",
        "limit": 1
      },
      "expect": {
        "/result/total": 2,
        "/result/next_offset": 1
      },
      "absent": [
        "/result/references/1"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "review_carry",
        "doc": "a.dxf",
        "review": "a.dxf",
        "target": "plan"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "review.file.invalid"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "review_carry",
        "doc": "a.dxf",
        "review": "review.json",
        "target": "model"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "review.target.missing"
      }
    }
  ]
}
