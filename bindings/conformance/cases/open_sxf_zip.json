{
  "description": "SXF を ZIP に入れた書庫（P2Z・SFZ、#385）を開く。最初の .p21・.sfc の項目を SXF として読み、ほかの項目は書庫の中の名前で返す。apply は SXF の項目だけを置き換え、ほかの項目を写した書庫（stored、日時を固定）を書く。",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "b.sfz",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "b.sfz"
      },
      "expect": {
        "/result/format": "sxf",
        "/result/entries": [
          "B.SAF",
          "IMAGE/A.JPG"
        ],
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "b.sfz",
        "edits": [
          {
            "kind": "transform",
            "id": "sheet/0/i20",
            "hash": "v2:3cd4fc9c730a53ace57631c672207755",
            "matrix": [
              1,
              0,
              5,
              0,
              1,
              7
            ]
          }
        ]
      },
      "expect": {
        "/result/applied/0/id": "sheet/0/i20"
      }
    }
  ]
}
