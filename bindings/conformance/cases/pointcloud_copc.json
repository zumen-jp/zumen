{
  "description": "open の pointcloud の条件で、COPC を八分木の節の範囲だけで読む（#899）。入力は crates/zumen-las/tests/copc.rs と同じ、copc_make.py が lazrs 0.9.0 で作った 10 点の合成の COPC（根の立方体は中心 (東 1000, 北 2000, 標高 50)・辺の半分 8、座標系は EPSG:6677）。初めの 589 バイトだけを渡し、size と南西の箱を書いて開くと、VLR と根の頁、次に箱に掛かる 2 つの節のチャンクを needs で求め、渡した範囲を done で返す。包み（#474）と同じく、範囲をその名前で渡して同じ要求を呼び直す。全体を渡しても、上限・許容差の条件に掛かる節だけを読む。条件の値の誤りと、COPC でない入力の条件は call.value.invalid にする",
  "module": "pointcloud",
  "steps": [
    {
      "push": {
        "name": "c.laz",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "c.laz",
        "size": 1520,
        "pointcloud": {
          "region": {
            "min": [
              1992,
              992,
              42
            ],
            "max": [
              1999.5,
              999.5,
              58
            ]
          }
        }
      },
      "expect": {
        "/result/doc": "c.laz",
        "/result/format": "las",
        "/result/needs": [
          {
            "input": "c.laz#375-855",
            "start": 375,
            "end": 855
          },
          {
            "input": "c.laz#1360-1456",
            "start": 1360,
            "end": 1456
          }
        ]
      }
    },
    {
      "push": {
        "name": "c.laz#375-855",
        "hex": ""
      }
    },
    {
      "push": {
        "name": "c.laz#1360-1456",
        "hex": "000000000000000000000000000000005f03000000000000700000000300000001000000000000000000000000000000cf03000000000000610000000200000001000000010000000100000000000000b00500000000000040000000ffffffff"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "c.laz",
        "size": 1520,
        "pointcloud": {
          "region": {
            "min": [
              1992,
              992,
              42
            ],
            "max": [
              1999.5,
              999.5,
              58
            ]
          }
        }
      },
      "expect": {
        "/result/needs": [
          {
            "input": "c.laz#863-975",
            "start": 863,
            "end": 975
          },
          {
            "input": "c.laz#975-1072",
            "start": 975,
            "end": 1072
          }
        ]
      }
    },
    {
      "push": {
        "name": "c.laz#863-975",
        "hex": "44fdffff44fdffffcc100000010011000200000001000000000000005940030000000d000000070000000000000000000000050000000000000000000000000000001100000020b50495973ccdcee5fb0000005aa07139af000007c00000004a779bdee400020bff271e000001000000"
      }
    },
    {
      "push": {
        "name": "c.laz#975-1072",
        "hex": "25feffffa2feffff30110000040011000200000001000000000000c059400200000008000000050000000000000000000000040000000000000000000000000000000a0000002096c1b3680000004d5f000000080000004a779bdee40001000000"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "c.laz",
        "size": 1520,
        "pointcloud": {
          "region": {
            "min": [
              1992,
              992,
              42
            ],
            "max": [
              1999.5,
              999.5,
              58
            ]
          }
        }
      },
      "expect": {
        "/result/doc": "c.laz",
        "/result/truncated": false
      }
    },
    {
      "call": {
        "v": 1,
        "op": "pointcloud",
        "doc": "c.laz",
        "limit": 10
      },
      "expect": {
        "/result/points": 5,
        "/result/crs": 6677,
        "/result/depth": 1,
        "/result/nodes": 2,
        "/result/selected/positions/0": [
          1993,
          993,
          43
        ]
      }
    },
    {
      "push": {
        "name": "whole.laz",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "whole.laz",
        "doc": "few",
        "pointcloud": {
          "limit": 3
        }
      },
      "expect": {
        "/result/truncated": true
      }
    },
    {
      "call": {
        "v": 1,
        "op": "pointcloud",
        "doc": "few",
        "limit": 10
      },
      "expect": {
        "/result/points": 3
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "whole.laz",
        "doc": "coarse",
        "pointcloud": {
          "tolerance": 1.5
        }
      },
      "expect": {
        "/result/truncated": false
      }
    },
    {
      "call": {
        "v": 1,
        "op": "pointcloud",
        "doc": "coarse"
      },
      "expect": {
        "/result/points": 8
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "whole.laz",
        "doc": "all"
      },
      "expect": {
        "/result/format": "las"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "pointcloud",
        "doc": "all"
      },
      "expect": {
        "/result/points": 10
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "whole.laz",
        "doc": "bad",
        "pointcloud": {
          "tolerance": 0
        }
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.value.invalid",
        "/diagnostics/0/params/pointer": "/pointcloud/tolerance"
      }
    },
    {
      "push": {
        "name": "t.xyz",
        "text": "1000 2000 1\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "t.xyz",
        "format": "xyz",
        "pointcloud": {
          "limit": 1
        }
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.value.invalid",
        "/diagnostics/0/params/pointer": "/pointcloud"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "whole.laz",
        "doc": "copc_bytes",
        "pointcloud": {
          "limit": 3
        },
        "budget": {
          "input_bytes": 1
        }
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "budget.input-bytes.exceeded"
      }
    }
  ]
}
