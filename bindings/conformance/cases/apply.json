        "/diagnostics/0/code": "call.value.invalid",
        "/diagnostics/0/params/pointer": "/edits/0/matrix"
      },
      "absent": [
        "/result"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "a.dxf",
        "edits": [
          {
            "kind": "transform",
            "id": "space/0/h2F",
            "hash": "v1:a26c9a681fb6d4cc4488d5434023dc44",
            "matrix": [
              1,
              0,
              5,
