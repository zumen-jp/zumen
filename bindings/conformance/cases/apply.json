              1,
              7
            ]
          },
          {
            "kind": "restyle",
            "id": "space/0/h30",
            "hash": "v1:9d74d3aa418fe58cd1891b738b7d1cc2",
            "color": {
              "aci": 1
            },
            "line_weight": {
              "mm": 0.35
            }
          },
          {
            "kind": "remove",
