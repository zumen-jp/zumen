        "/result/applied/1/id": "space/0/h30",
        "/result/applied/2": {},
        "/blobs/0/kind": "file",
        "/diagnostics": []
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "a.dxf",
        "fields": [
          "kind",
          "hash"
        ]
      },
      "expect": {
