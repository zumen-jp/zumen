{
  "description": "R2007 より前の ANSI_932 の DXF の文字とレイヤ名を図面モデルに移す（決定 0175）",
  "steps": [
    {
      "push": {
        "name": "shift_jis.dxf",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "shift_jis.dxf"
      },
      "expect": {
        "/result/format": "dxf",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "shift_jis.dxf"
      },
      "expect": {
        "/result/spaces/0/elements/texts": 1,
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "shift_jis.dxf",
        "fields": [
          "kind",
          "layer",
          "geometry"
        ]
      },
      "expect": {
        "/result/total": 1,
        "/result/items/0/kind": "text",
        "/result/items/0/layer": "外形",
        "/result/items/0/geometry/content": "図面",
        "/diagnostics": []
      }
    }
  ]
}
