        "v": 1,
        "op": "building_elements",
        "doc": "default",
        "components": [
          "identity"
        ]
      },
      "expect": {
        "/result/elements/1/identity/name": "ｰ",
        "/result/elements/1/id": "0000000000000000000002",
        "/result/elements/0/identity/name": "テスト"
