{
  "description": "capabilities は、ABI とスキーマの版と、使える op・形式を返す（決定 0012・0015）。capabilities は、モジュールが持つ op と形式だけを返すので、すべてのモジュールを入れたコアでだけ流す（決定 0221）",
  "module": "all",
  "steps": [
    {
      "call": { "v": 1, "op": "capabilities" },
      "expect": {
        "/v": 1,
        "/result/abi": 1,
        "/result/schema/major": 1,
        "/result/ops": ["capabilities", "open", "close", "describe", "drawing", "entities", "apply", "convert", "tables", "scene", "check", "validate", "review_carry", "review_adopt", "building", "building_elements", "ids_check", "review_adopt_ids", "bcf_read", "bcf_write", "civil", "pointcloud"],
        "/result/formats": [
          { "id": "dxf", "family": "acad", "read": true, "write": true, "id_rules": 2 },
          { "id": "dwg", "family": "acad", "read": true, "write": true, "id_rules": 2 },
          { "id": "sxf", "family": "sxf", "read": true, "write": true, "id_rules": 2 },
          { "id": "jww", "family": "jww", "read": true, "write": true, "id_rules": 1 },
          { "id": "landxml", "family": "landxml", "read": true, "write": false, "id_rules": 1 },
          { "id": "las", "family": "las", "read": true, "write": false, "id_rules": 1 },
          { "id": "ply", "family": "ply", "read": true, "write": false, "id_rules": 1 },
          { "id": "xyz", "family": "xyz", "read": true, "write": false, "id_rules": 1 },
          { "id": "e57", "family": "e57", "read": true, "write": false, "id_rules": 1 }
        ],
        "/diagnostics": [],
        "/blobs": []
      }
    },
    {
      "call": { "v": 1, "op": "capabilities", "budget": { "records": 10, "work": "unlimited" }, "partial": true, "max_places": 0 },
      "expect": { "/result/abi": 1, "/diagnostics": [] }
    }
  ]
}
