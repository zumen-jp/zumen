{
  "description": "open は、基盤地図情報の配布の書庫（ZIP）を、中の FG-GML- で始まる .xml の項目の名前で見分け、中の GML を 1 つの地理の領域モデルにまとめる（決定 0251、#493）。地物の ID は、項目の名前と # と gml:id の組で、同じ gml:id でも項目で分かれる。基盤地図情報の GML でない項目は fgd.entry.unsupported を返す。",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "FG-GML-533945-ALL-20250801.zip",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "FG-GML-533945-ALL-20250801.zip",
        "doc": "a"
      },
      "expect": {
        "/result/format": "fgd",
        "/diagnostics/0/code": "fgd.entry.unsupported",
        "/diagnostics/0/params/name": "readme.txt"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "geo",
        "doc": "a"
      },
      "expect": {
        "/result/crs": 6668,
        "/result/height": 11317,
        "/result/features": 2,
        "/result/kinds": [
          {
            "kind": "fgd:RailCL",
            "count": 1
          },
          {
            "kind": "fgd:RdEdg",
            "count": 1
          }
        ]
      }
    },
    {
      "call": {
        "v": 1,
        "op": "geo",
        "doc": "a",
        "id": "FG-GML-533945-RailCL-20250801-0001.xml#K1_1"
      },
      "expect": {
        "/result/feature/kind": "fgd:RailCL",
        "/result/feature/geometries": [
          {
            "form": "line",
            "points": 2
          }
        ]
      }
    }
  ]
}
