{
  "description": "R2000 の ANSI_936・ANSI_949・ANSI_950 の DXF の文字とレイヤ名を、Windows の表（Unicode の CP936・CP949・CP950.TXT）で読み、書き戻して開き直しても同じ文字になる。表せない文字は変更全体を拒む。Big5 のレイヤ名の乙（A4 41）は 2 バイト目が ASCII の英字で、F9 FE は Microsoft の表の ▓ として読む（#327）",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "gbk.dxf",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "gbk.dxf"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "gbk.dxf",
        "fields": [
          "id",
          "kind",
          "layer",
          "geometry"
        ]
      },
      "expect": {
        "/result/total": 1,
        "/result/items/0/id": "space/0/h1A",
        "/result/items/0/layer": "墙体",
        "/result/items/0/geometry/content": "门 № 2 €"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "gbk.dxf",
        "edits": [
          {
            "kind": "add",
            "place": "space/0",
            "layer_id": "layer/0",
            "geometry": {
              "shape": "text",
              "content": "ภ",
              "position": [
                1,
                2
              ],
              "height": 2.5,
              "rotation": 0
            }
          }
        ]
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "change.edit.unsupported",
        "/diagnostics/1/code": "change.character.unsupported",
        "/diagnostics/1/params/character": "U+0E20"
      },
      "absent": [
        "/result"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "gbk.dxf",
        "edits": [
          {
            "kind": "add",
            "place": "space/0",
            "layer_id": "layer/0",
            "geometry": {
              "shape": "text",
              "content": "窗 – 中文",
