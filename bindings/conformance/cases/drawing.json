{
  "description": "drawing は、開いた文書を図面モデル（L2）に変換し、空間と用紙ごとの単位・要素の数・範囲を返す。移さない図形は診断で返し、作業は表を作るときにレコードごと、変換で ENTITIES の図形ごとに 1 つ使い、止まる所はネイティブと wasm で同じになる（決定 0007・0010・0022）",
  "steps": [
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.dxf"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.document.missing",
        "/diagnostics/0/params/name": "a.dxf"
      },
      "absent": [
        "/result"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "../a"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.value.invalid",
        "/diagnostics/0/params/pointer": "/doc"
      }
    },
    {
      "push": {
        "name": "a.dxf",
        "text": "0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1015\n9\n$INSUNITS\n70\n4\n9\n$PLIMMIN\n10\n0.0\n20\n0.0\n9\n$PLIMMAX\n10\n420.0\n20\n297.0\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n8\n0\n10\n1.5\n20\n2.0\n11\n100.0\n21\n50.0\n0\nTEXT\n8\nTEXT\n10\n-3.0\n20\n4.0\n40\n2.5\n1\nABC\n0\nLINE\n8\n0\n67\n1\n10\n10.0\n20\n10.0\n11\n410.0\n21\n287.0\n0\nPOINT\n8\n0\n10\n0.0\n20\n0.0\n0\nENDSEC\n0\nEOF\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.dxf"
      },
      "expect": {
        "/result/format": "dxf"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.dxf"
      },
      "expect": {
        "/result": {
          "spaces": [
            {
              "unit": "millimeter",
              "elements": {
                "lines": 1,
                "texts": 1
              },
              "extent": {
                "min_x": -3,
                "min_y": 2,
                "max_x": 100,
                "max_y": 50
              }
            }
          ],
          "sheets": [
            {
              "size": [
                420,
                297
              ],
              "elements": {
                "lines": 1,
                "texts": 0
              },
              "views": 0,
              "extent": {
                "min_x": 10,
                "min_y": 10,
                "max_x": 410,
                "max_y": 287
              }
            }
          ]
        },
        "/diagnostics/0/code": "dxf.lift.dropped",
        "/diagnostics/0/params/kind": "POINT",
        "/diagnostics/0/at/0/record": 6
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.dxf",
        "budget": {
          "work": 3
        }
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "budget.work.exceeded",
        "/diagnostics/0/params/limit": 3,
        "/diagnostics/0/params/requested": 4
      },
      "absent": [
        "/result"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.dxf",
        "budget": {
          "work": 12
        }
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "budget.work.exceeded",
        "/diagnostics/0/params/limit": 12,
        "/diagnostics/0/params/requested": 13
      },
      "absent": [
        "/result"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.dxf",
        "budget": {
          "work": 13
        }
      },
      "expect": {
        "/result/spaces/0/elements/lines": 1,
        "/result/sheets/0/elements/lines": 1
      }
    }
  ]
}
