{
  "description": "photo は、工事写真（JPEG）の Exif と XMP を読み、画素数・向き・撮影の日時・GPS の位置・XMP の性質を返す（#387）。画像は復号しない。JPEG の始まりの印がなければ jpeg.file.invalid で失敗する。試験の JPEG は個人情報のない合成のもの。",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "a.jpg",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "photo",
        "input": "a.jpg"
      },
      "expect": {
        "/result/width": 64,
        "/result/height": 48,
        "/result/orientation": 1,
        "/result/taken": "2026-10-31T09:15:30+09:00",
        "/result/make": "zumen",
        "/result/position/longitude": 139.75,
        "/result/position/altitude": 12.5,
        "/result/datum": "WGS-84",
        "/result/xmp": [
          {
            "namespace": "http://ns.adobe.com/xap/1.0/",
            "name": "Rating",
            "value": "3"
          }
        ],
        "/diagnostics": []
      }
    },
    {
      "push": {
        "name": "b.jpg",
        "text": "not a jpeg"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "photo",
        "input": "b.jpg"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "jpeg.file.invalid"
      }
    }
  ]
}
