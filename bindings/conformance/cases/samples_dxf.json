        "/result/spaces/0/elements": {
          "lines": 10,
          "texts": 16
        },
        "/result/spaces/0/extent": {
          "min_x": 0,
          "min_y": -1.5,
          "max_x": 35,
          "max_y": 15
        },
        "/result/sheets/0/name": "Layout1",
        "/result/sheets/0/elements": {
          "lines": 0,
          "texts": 0
        },
        "/diagnostics": []
      },
      "absent": [
        "/result/spaces/1",
        "/result/sheets/1"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "text_alignments.dxf",
        "fields": [
          "kind"
        ],
        "offset": 24,
        "limit": 3
      },
      "expect": {
        "/result/total": 58,
        "/result/items": [
          {
