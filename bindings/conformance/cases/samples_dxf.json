        "/result/layers/1/name": "Defpoints",
        "/result/layers/1/printable": false,
        "/result/layers/2": {
          "id": "layer/2",
          "name": "INSERT_POINTS",
          "hash": "v2:982f04b0c9e916fb5624ba21052de5f8",
