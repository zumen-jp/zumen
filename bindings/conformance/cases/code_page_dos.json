{
  "description": "R2000 の DOS866 の DXF の文字と名前を Windows の 866 の表で読み、書き戻して開き直しても同じ文字になる。866 で表せない文字は変更全体を拒む（#327）",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "dos866.dxf",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "dos866.dxf"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "dos866.dxf",
        "fields": [
          "id",
          "kind",
          "layer",
          "geometry"
        ]
      },
      "expect": {
        "/result/total": 1,
        "/result/items/0/id": "space/0/h1A",
        "/result/items/0/layer": "Стены",
        "/result/items/0/geometry/content": "Дверь № 2 ░ 50 %"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "tables",
        "doc": "dos866.dxf"
      },
      "expect": {
        "/result/layers/0/id": "layer/0",
        "/result/layers/0/name": "Стены"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "dos866.dxf",
        "edits": [
          {
            "kind": "add",
            "place": "space/0",
            "layer_id": "layer/0",
            "geometry": {
              "shape": "text",
              "content": "«Ё»",
              "position": [
                1,
                2
              ],
              "height": 2.5,
              "rotation": 0
            }
          }
        ]
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "change.edit.unsupported",
        "/diagnostics/1/code": "change.character.unsupported",
        "/diagnostics/1/params/character": "U+00AB"
      },
      "absent": [
        "/result"
      ]
    },
    {
      "call": {
        "v": 1,
        "op": "apply",
        "doc": "dos866.dxf",
        "edits": [
          {
            "kind": "add",
            "place": "space/0",
            "layer_id": "layer/0",
            "geometry": {
              "shape": "text",
              "content": "Окно ї ■",
              "position": [
                1,
                2
              ],
              "height": 2.5,
              "rotation": 0
            }
          }
        ]
      },
      "expect": {
        "/result/applied/0/id": "space/0/h80"
      }
    },
    {
      "take": 0
    },
    {
      "call": {
        "v": 1,
        "op": "entities",
        "doc": "dos866.dxf",
        "fields": [
          "id",
          "kind",
          "layer",
          "geometry"
        ]
      },
      "expect": {
        "/result/total": 2,
        "/result/items/1/id": "space/0/h80",
        "/result/items/1/layer": "Стены",
        "/result/items/1/geometry/content": "Окно ї ■"
      }
    }
  ]
}
