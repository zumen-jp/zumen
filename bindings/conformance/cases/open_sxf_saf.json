{
  "description": "open は、SXF の属性ファイル（SAF）を、saf に名指した入力か、P2Z・SFZ の中の図面と同じ名前の項目から読み、属性ファイル用の属性付加機構（$$ATRF$$）の要素に属性ごとの sxf.saf の拡張で結ぶ（決定 0249、#386）。結ぶのは図面モデルへの変換（lift・drawing）で、図面の図形識別番号の図形が属性ファイルになければ sxf.saf-figure.missing を、属性ファイルの図形の要素が図面になければ sxf.saf-figure.dropped を返す。SXF でない入力に saf を書くと断る。lift の図面モデルのバイナリが、ネイティブと wasm で同じバイト列になることを確かめる",
  "module": "drawing",
  "steps": [
    {
      "push": {
        "name": "D0PL001Z.SFC",
        "text": "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION(('SCADEC level2 feature_mode'),'2;1');\nFILE_SCHEMA(('ASSOCIATIVE_DRAUGHTING'));\nENDSEC;\nDATA;\n/*SXF3\n#10 = layer_feature('L','1')\nSXF3*/\n/*SXF3\n#20 = line_feature('1','1','1','1','0','0','1','0')\nSXF3*/\n/*SXF3\n#30 = sfig_org_feature('$$ATRF$$10$$D0PL001Z.SAF','3')\nSXF3*/\n/*SXF3\n#40 = line_feature('1','1','1','1','0','0','2','2')\nSXF3*/\n/*SXF3\n#50 = sfig_org_feature('$$ATRF$$30','3')\nSXF3*/\n/*SXF3\n#60 = sfig_locate_feature('1','$$ATRF$$10$$D0PL001Z.SAF','0','0','0','1','1')\nSXF3*/\n/*SXF3\n#70 = sfig_locate_feature('1','$$ATRF$$30','0','0','0','1','1')\nSXF3*/\n/*SXF3\n#80 = drawing_sheet_feature('S','3','1','0','0')\nSXF3*/\nENDSEC;\nEND-ISO-10303-21;\n"
      }
    },
    {
      "push": {
        "name": "D0PL001Z.SAF",
        "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE SxfAttributeXML SYSTEM \"SXFV31.DTD\">\n<SxfAttributeXML version=\"3.1\" date=\"2026-11-03\" sxfFile=\"D0PL001Z.SFC\" application=\"XX-CAD\">\n  <AttributeSet name=\"計画設計\" version=\"1.0\" designedBy=\"○○協会\">1</AttributeSet>\n  <Figure id=\"10\" name=\"道路横断図形\">\n    <AttrSetRef id=\"1\">\n      <AttrGroup name=\"測点\">\n        <Attr name=\"測点名\" type=\"STR\">No.1</Attr>\n        <Attr name=\"現地盤高\" type=\"LEN\" unit=\"m\">102.0400</Attr>\n      </AttrGroup>\n    </AttrSetRef>\n  </Figure>\n  <Figure id=\"21\" name=\"切盛土エリア\">\n    <AttrSetRef id=\"1\">\n      <Attr name=\"切盛土区分\" type=\"STR\">切土</Attr>\n    </AttrSetRef>\n  </Figure>\n</SxfAttributeXML>\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "D0PL001Z.SFC",
        "saf": "none.saf"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.input.missing"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "D0PL001Z.SFC",
        "saf": "D0PL001Z.SAF"
      },
      "expect": {
        "/result/format": "sxf",
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "lift",
        "doc": "D0PL001Z.SFC"
      },
      "expect": {
        "/result/blob": 0,
        "/blobs/0/kind": "drawing",
        "/diagnostics/0/code": "sxf.saf-figure.missing",
        "/diagnostics/0/params/figure": "30",
        "/diagnostics/1/code": "sxf.saf-figure.dropped",
        "/diagnostics/1/params/figure": "21"
      }
    },
    {
      "push": {
        "name": "a.p2z",
        "hex": ""
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.p2z"
      },
      "expect": {
        "/result/format": "sxf",
        "/result/entries": [
          "D0PL001Z.SAF"
        ],
        "/diagnostics": []
      }
    },
    {
      "call": {
        "v": 1,
        "op": "drawing",
        "doc": "a.p2z"
      },
      "expect": {
        "/diagnostics/0/code": "sxf.saf-figure.missing",
        "/diagnostics/1/code": "sxf.saf-figure.dropped"
      }
    },
    {
      "push": {
        "name": "a.dxf",
        "text": "0\nSECTION\n2\nENTITIES\n0\nENDSEC\n0\nEOF\n"
      }
    },
    {
      "call": {
        "v": 1,
        "op": "open",
        "input": "a.dxf",
        "saf": "D0PL001Z.SAF"
      },
      "status": "failed",
      "expect": {
        "/diagnostics/0/code": "call.value.invalid",
        "/diagnostics/0/params/pointer": "/saf"
      }
    }
  ]
}
