<?xml version="1.0" encoding="UTF-8"?>
<!-- Java のラッパー（決定 0224）。バージョンはコアと同じにし、xtask が確かめる（決定 0015）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.zumen</groupId>
  <artifactId>zumen</artifactId>
  <version>0.4.0</version>
  <packaging>jar</packaging>
  <name>zumen</name>
  <description>zumen の C ABI を JNA で呼ぶラッパー</description>
  <url>https://github.com/zumen-jp/zumen</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>zumen-jp</id>
      <name>zumen contributors</name>
      <url>https://github.com/zumen-jp</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/zumen-jp/zumen.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/zumen-jp/zumen.git</developerConnection>
    <url>https://github.com/zumen-jp/zumen</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- docs/support.md の下限 -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <!-- Apache-2.0 と LGPL-2.1 以降の二重のライセンス。Apache-2.0 で使う -->
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.19.1</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <includes><include>README.md</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE-MIT</include>
          <include>LICENSE-APACHE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>api-guide</id>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <includes>
                    <include>README.md</include>
                    <include>META-INF/LICENSE-*</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <skipUpload>true</skipUpload>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
