<!--
  zumen の C ABI を、P/Invoke（関数ポインターの委譲）で呼ぶ薄い包み（決定 0011・0196）。

  NuGet の Zumen で配る（決定 0003・0205）。対象ごとのネイティブのライブラリを runtimes/{rid}/native に入れる。
  ライブラリは、リリースのワークフローが runtimes/{rid}/native に置いてから dotnet pack する。
  版はコアと同じにし、AssemblyVersion は ABI の大版に固定する。どちらも cargo xtask codegen の検査が確かめる
  （決定 0015）。強い名前はまだ付けない。

  docs/support.md の下限に合わせ、.NET Framework 4.8 には netstandard2.0、.NET 8 以降には net8.0 のアセンブリを出す。
  NuGet の依存を持たない。JSON の型つきの読み書き（System.Text.Json）は、標準で持つ net8.0 の側にだけある。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Zumen</AssemblyName>
    <RootNamespace>Zumen</RootNamespace>
    <Version>0.2.0</Version>
    <!-- .NET Framework 4.8 のホストで同じ大版を 1 つとして扱うため、ABI の大版に固定する（決定 0015） -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageId>Zumen</PackageId>
    <Description>日本の建設の図面（DXF・DWG・SXF・JWW）を読み書きする zumen の、.NET の包み</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/zumen-jp/zumen</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes" />
  </ItemGroup>

</Project>
