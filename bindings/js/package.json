{
  "name": "@zumen-jp/zumen",
  "version": "0.3.0",
  "description": "日本の建設の図面（DXF・DWG・SXF・JWW）を読み書きする zumen の、wasm と TypeScript・JavaScript のラッパー",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumen-jp/zumen.git",
    "directory": "bindings/js"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.js"
    },
    "./wasm": {
      "types": "./src/wasm.d.ts",
      "default": "./src/wasm.js"
    },
    "./zumen_abi1.wasm": "./zumen_abi1.wasm",
    "./zumen_abi1_drawing.wasm": "./zumen_abi1_drawing.wasm",
    "./zumen_abi1_bim.wasm": "./zumen_abi1_bim.wasm",
    "./zumen_abi1_civil.wasm": "./zumen_abi1_civil.wasm",
    "./zumen_abi1_pointcloud.wasm": "./zumen_abi1_pointcloud.wasm"
  },
  "files": [
    "src",
    "sboms",
    "zumen_abi1.wasm",
    "zumen_abi1_drawing.wasm",
    "zumen_abi1_bim.wasm",
    "zumen_abi1_civil.wasm",
    "zumen_abi1_pointcloud.wasm",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_LICENSES"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node test/conformance.mjs ../../target/wasm32-unknown-unknown/release/zumen_abi1.wasm"
  }
}
