        "document": "photo",
        "item": "表 3-1",
        "section": "3"
      }
    },
    {
      "check": "delivery-standard",
      "element": "適用要領基準",
      "folders": ["PHOTO/PHOTO.XML"],
      "id": "photo-standard",
      "level": "error",
      "source": {
        "document": "photo",
        "item": "表 3-1",
        "section": "3"
      },
      "values": ["土木202303-01"]
    },
    {
      "check": "delivery-characters",
      "folders": ["PHOTO/PHOTO.XML"],
      "fullwidth-alphanumerics": false,
      "id": "photo-characters",
      "level": "warning",
      "source": {
        "document": "photo",
        "section": "9-2"
      }
    },
    {
      "check": "delivery-photo-date",
      "date": "撮影年月日",
      "entry": "写真情報",
      "file": "写真ファイル名",
      "folders": ["PHOTO/PHOTO.XML"],
      "id": "photo-date",
      "level": "warning",
      "source": {
        "basis": "chosen",
        "document": "photo",
        "item": "表 3-1",
        "section": "3"
      }
    },
    {
      "check": "delivery-photo-pixels",
      "folders": ["PHOTO/PIC/"],
      "id": "photo-pixels",
      "level": "info",
      "max": 3000000,
      "min": 1000000,
      "source": {
        "basis": "chosen",
        "document": "photo",
        "section": "7"
      }
    }
