    {
      "check": "delivery-doctype",
      "folders": ["PHOTO/PHOTO.XML"],
      "id": "photo-doctype",
      "level": "error",
      "source": {
        "document": "photo",
        "section": "5"
      },
      "values": ["PHOTO05.DTD"]
    },
    {
      "characters": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_",
      "check": "delivery-name",
      "depth": 3,
      "extension": 4,
      "folders": ["PHOTO/PIC/"],
      "id": "photo-name",
      "level": "warning",
      "prefix": "P",
      "source": {
        "document": "photo",
        "item": "図 5-1",
        "section": "5"
      },
      "stem": 8
    },
    {
      "characters": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_",
      "check": "delivery-name",
      "depth": 3,
      "extension": 4,
      "folders": ["PHOTO/DRA/"],
      "id": "photo-drawing-name",
      "level": "warning",
      "prefix": "D",
      "source": {
        "document": "photo",
        "item": "図 5-2",
        "section": "5"
      },
      "stem": 8
