    {
      "check": "delivery-doctype",
      "folders": ["MEET/MEET.XML"],
      "id": "doctype-meet",
      "level": "error",
      "source": {
        "document": "main",
        "section": "6"
      },
      "values": ["MEET05.DTD"]
    },
    {
      "check": "delivery-doctype",
      "folders": ["REGISTER/REGISTER.XML"],
      "id": "doctype-register",
