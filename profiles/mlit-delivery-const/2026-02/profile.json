{
  "edition": "2026-02",
  "format": "0.1",
  "id": "mlit-delivery-const",
  "license": "CC-BY-4.0",
  "revision": 2,
  "rules": [
    {
      "characters": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-",
      "check": "delivery-name",
      "except": ["BIMCIM/", "DRAWINGF/", "DRAWINGS/", "BORING/", "ICON/"],
      "extension": 4,
      "folder": 8,
      "id": "name",
      "level": "warning",
      "source": {
        "document": "main",
        "section": "6"
      },
      "stem": 8
    },
    {
      "check": "delivery-name",
      "depth": 3,
      "folders": ["PLAN/", "MEET/", "REGISTER/", "OTHRS/"],
      "id": "depth",
      "level": "warning",
      "source": {
        "basis": "chosen",
        "document": "main",
        "section": "3"
      }
    },
    {
      "check": "delivery-required",
      "id": "index",
      "level": "error",
      "names": ["INDEX_C.XML"],
      "source": {
        "document": "main",
        "item": "表 4-1",
        "section": "4"
      }
    },
    {
      "check": "delivery-required",
      "id": "plan",
      "level": "error",
      "names": ["PLAN/PLAN.XML"],
      "source": {
        "document": "main",
        "section": "3"
      },
      "when": "PLAN/"
    },
    {
      "check": "delivery-required",
      "id": "meet",
      "level": "error",
      "names": ["MEET/MEET.XML"],
      "source": {
        "document": "main",
        "section": "3"
      },
      "when": "MEET/"
    },
    {
      "check": "delivery-required",
      "id": "register",
      "level": "error",
      "names": ["REGISTER/REGISTER.XML", "REGISTER/PRE-PIC.JPG", "REGISTER/POST-PIC.JPG"],
      "source": {
        "document": "main",
        "item": "表 4-2",
        "section": "4"
      },
      "when": "REGISTER/"
