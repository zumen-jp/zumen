      "level": "warning",
      "source": {
        "basis": "chosen",
        "document": "main",
        "item": "表 4-3",
        "section": "4"
      }
    },
    {
      "check": "delivery-standard",
      "element": "適用要領基準",
      "folders": ["INDEX_C.XML"],
      "id": "standard",
      "level": "error",
      "source": {
        "basis": "chosen",
        "document": "main",
        "item": "表 4-1",
        "section": "4"
