    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h20" }, { "kind": "element", "id": "space/0/h20" }] }, "status": "failed", "expect": { "/diagnostics/0/code": "call.value.invalid", "/diagnostics/0/params/pointer": "/subject/1" } },
    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h20" }], "clip": [{ "kind": "element", "id": "space/0/h21" }] }, "status": "failed", "expect": { "/diagnostics/0/params/pointer": "/clip" } },
    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h20" }], "fill": "even_odd" }, "status": "failed", "expect": { "/diagnostics/0/params/pointer": "/fill" } },
    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h20" }], "tolerance": 0 }, "status": "failed", "expect": { "/diagnostics/0/params/pointer": "/tolerance" } },
    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h20" }], "expected_hash": "wrong" }, "status": "failed", "expect": { "/diagnostics/0/params/pointer": "/expected_hash" } },
    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h20" }], "budget": { "work": 0 } }, "status": "failed", "expect": { "/diagnostics/0/code": "budget.work.exceeded" }, "absent": ["/result"] },
    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h29" }], "budget": { "segments": 0 } }, "status": "failed", "expect": { "/diagnostics/0/code": "budget.segments.exceeded" }, "absent": ["/result"] },
    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "detect", "subject": [{ "kind": "element", "id": "space/0/h20" }] }, "expect": { "/result/regions/0/area": 100 } },
    { "call": { "v": 1, "op": "drawing", "doc": "regions" }, "expect": { "/result/hash": "v2:45454545454545454545454545454545" } }
