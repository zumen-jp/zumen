    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "xor", "subject": [{ "kind": "element", "id": "space/0/h20" }], "clip": [{ "kind": "element", "id": "space/0/h21" }] }, "expect": { "/result/regions/0/area": 75, "/result/regions/1/area": 75 }, "absent": ["/result/regions/2"] },
