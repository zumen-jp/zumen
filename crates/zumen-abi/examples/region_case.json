    { "call": { "v": 1, "op": "regions", "doc": "regions", "from": "space/0", "operation": "union", "subject": [{ "kind": "element", "id": "space/0/h20" }, { "kind": "element", "id": "space/0/h23" }] }, "status": "failed", "expect": { "/diagnostics/0/code": "drawing.element-region.failed", "/diagnostics/0/params/id": "space/0/h23", "/diagnostics/0/params/reason": "not-closed", "/diagnostics/0/at/0/record": 2 }, "absent": ["/result"] },
