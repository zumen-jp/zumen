{
  "description": "合成の全曲線種で長さ・周長・面積・最短距離、近似と未対応の診断、公開ID・単位・予算停止を確かめる。measurement_case.rs から再生成する",
  "module": "drawing",
  "steps": [
    { "push": { "name": "measure", "hex": "$HEX" } },
    { "call": { "v": 1, "op": "open", "input": "measure" }, "expect": { "/result/format": "test-measure" } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h10" } }, "expect": { "/result/value": 5, "/result/approximate": false, "/result/unit": "millimeter", "/result/unit_power": 1, "/result/hash": "v2:33333333333333333333333333333333" }, "absent": ["/diagnostics/0", "/result/nearest_first"] },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h10/1" } }, "expect": { "/result/value": 7 } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "perimeter", "first": { "kind": "element", "id": "space/0/h11" } }, "expect": { "/result/value": 12.566370614359172, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "area", "first": { "kind": "element", "id": "space/0/h11" } }, "expect": { "/result/value": 12.566370614359172, "/result/unit_power": 2 } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h12" } }, "expect": { "/result/value": 7.853981633974483, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "perimeter", "first": { "kind": "element", "id": "space/0/h13" } }, "expect": { "/result/value": 12, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "area", "first": { "kind": "element", "id": "space/0/h13" } }, "expect": { "/result/value": 6 } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "perimeter", "first": { "kind": "element", "id": "space/0/h14" } }, "expect": { "/result/approximate": true, "/diagnostics/0/code": "drawing.element-measurement.approximated", "/diagnostics/0/params/id": "space/0/h14", "/diagnostics/0/params/tolerance": 0.001 } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "area", "first": { "kind": "element", "id": "space/0/h14" } }, "expect": { "/result/value": 157.07963267948966, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h15" } }, "expect": { "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h16" } }, "expect": { "/result/value": 20, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h17" } }, "expect": { "/result/value": 10, "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "area", "first": { "kind": "element", "id": "space/0/h20" } }, "expect": { "/result/value": 100, "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "perimeter", "first": { "kind": "element", "id": "space/0/h20" } }, "expect": { "/result/value": 40 } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h10" }, "second": { "kind": "element", "id": "space/0/h13" } }, "expect": { "/result/value": 0, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h11" }, "second": { "kind": "point", "position": { "x": 10, "y": 0 } } }, "expect": { "/result/value": 2, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h12" }, "second": { "kind": "element", "id": "space/0/h11" } }, "expect": { "/result/value": 3, "/result/approximate": false } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h14" }, "second": { "kind": "element", "id": "space/0/h11" } }, "expect": { "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h15" }, "second": { "kind": "point", "position": { "x": 5, "y": 10 } } }, "expect": { "/result/value": 5, "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h16" }, "second": { "kind": "point", "position": { "x": 0, "y": 0 } } }, "expect": { "/result/value": 0, "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h19" }, "second": { "kind": "point", "position": { "x": -2, "y": -1 } } }, "expect": { "/result/value": 5 } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/1", "quantity": "distance", "first": { "kind": "point", "position": { "x": 0, "y": 0 } }, "second": { "kind": "point", "position": { "x": 3, "y": 4 } } }, "expect": { "/result/value": 5, "/result/unit": "unknown" } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "area", "first": { "kind": "element", "id": "space/0/h12" } }, "status": "failed", "expect": { "/diagnostics/0/code": "drawing.element-measurement.failed", "/diagnostics/0/params/reason": "not-closed" }, "absent": ["/result"] },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h18" } }, "status": "failed", "expect": { "/diagnostics/0/code": "drawing.element-measurement.failed", "/diagnostics/0/params/reason": "unsupported-shape" }, "absent": ["/result"] },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/1/h10" } }, "status": "failed", "expect": { "/diagnostics/0/params/reason": "id-not-found" }, "absent": ["/result"] },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h10" }, "expected_hash": "wrong" }, "status": "failed", "expect": { "/diagnostics/0/code": "call.value.invalid", "/diagnostics/0/params/pointer": "/expected_hash" } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h10" } }, "status": "failed", "expect": { "/diagnostics/0/params/pointer": "/second" } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h10" }, "tolerance": 0 }, "status": "failed", "expect": { "/diagnostics/0/params/pointer": "/tolerance" } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h10" }, "budget": { "work": 0 } }, "status": "failed", "expect": { "/diagnostics/0/code": "budget.work.exceeded" }, "absent": ["/result"] },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h15" }, "budget": { "segments": 0 } }, "status": "failed", "expect": { "/diagnostics/0/code": "budget.segments.exceeded" }, "absent": ["/result"] },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h16" }, "second": { "kind": "point", "position": { "x": 25, "y": 0 } } }, "expect": { "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h14" }, "second": { "kind": "point", "position": { "x": 20, "y": 20 } } }, "expect": { "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "distance", "first": { "kind": "element", "id": "space/0/h17" }, "second": { "kind": "point", "position": { "x": 5, "y": 3 } } }, "expect": { "/result/value": 3, "/result/approximate": true } },
    { "call": { "v": 1, "op": "measure", "doc": "measure", "from": "space/0", "quantity": "length", "first": { "kind": "element", "id": "space/0/h10" } }, "expect": { "/result/value": 5 } },
    { "call": { "v": 1, "op": "drawing", "doc": "measure" }, "expect": { "/result/hash": "v2:33333333333333333333333333333333" } }
  ]
}
