{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zumen.dev/schema/messages.json",
  "title": "zumen の境界のメッセージ",
  "description": "zm_call で渡す要求と、返す応答（決定 0012）。版は schema/boundary.toml にある。書き方は schema/README.md にある。",
  "$defs": {
    "request": {
      "description": "要求。op の値で形が決まる",
      "oneOf": [
        { "$ref": "#/$defs/capabilities_request" },
        { "$ref": "#/$defs/open_request" },
        { "$ref": "#/$defs/close_request" },
        { "$ref": "#/$defs/describe_request" },
        { "$ref": "#/$defs/drawing_request" },
        { "$ref": "#/$defs/entities_request" },
        { "$ref": "#/$defs/apply_request" },
        { "$ref": "#/$defs/tables_request" }
      ]
    },
    "request_common": {
      "description": "どの op の要求にも置ける欄",
      "type": "object",
      "properties": {
        "v": {
          "description": "メッセージのスキーマの大版。今は 1",
          "type": "integer",
          "minimum": 1
        },
        "budget": {
          "description": "予算の単位ごとの上限。書かない単位は既定値にする（決定 0010）",
          "$ref": "#/$defs/budget"
        },
        "partial": {
          "description": "予算で止まったとき、止まった所までの結果を求める。書かなければ false（決定 0010）",
          "type": "boolean"
        },
        "max_places": {
          "description": "診断ごとに返す場所の数。書かなければ 16（決定 0009）",
          "type": "integer",
          "minimum": 0
        },
        "time_limit_ms": {
          "description": "時間の上限（ミリ秒）。ネイティブの境界が時計を見て止める。止まる所は環境で変わる。wasm では受け付けない（決定 0010）",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["v"]
    },
    "budget": {
      "description": "予算の単位ごとの上限（決定 0010）",
      "type": "object",
      "properties": {
        "input_bytes": { "description": "受け取ったバイト数", "$ref": "#/$defs/limit" },
        "decoded_bytes": { "description": "展開・復号で作ったバイト数。入れ子の分も足す", "$ref": "#/$defs/limit" },
        "records": { "description": "L0・L1 で読んだレコードの数", "$ref": "#/$defs/limit" },
        "elements": { "description": "L2・L3 で作った要素の数", "$ref": "#/$defs/limit" },
        "depth": { "description": "入れ子と再帰の深さ", "$ref": "#/$defs/limit" },
        "segments": { "description": "幾何の分割で作った点・線・面の数", "$ref": "#/$defs/limit" },
        "work": { "description": "ほかの単位に入らない繰り返しの回数", "$ref": "#/$defs/limit" }
      },
      "additionalProperties": false
    },
    "limit": {
      "description": "1 つの単位の上限。上限をなくすときは unlimited と書く",
      "oneOf": [
        { "description": "この量までは使える", "type": "integer", "minimum": 0 },
        { "description": "上限なし", "const": "unlimited" }
      ]
    },
    "capabilities_request": {
      "description": "コアの版と、使える op・形式を尋ねる",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "capabilities" }
      },
      "required": ["op"],
      "unevaluatedProperties": false
    },
    "capabilities_result": {
      "description": "コアの版と、使える op・形式（決定 0015）",
      "type": "object",
      "properties": {
        "package": { "description": "パッケージの版（semver）", "type": "string" },
        "abi": { "description": "ABI の大版。zm_abi_version と同じ", "type": "integer", "minimum": 1 },
        "schema": { "description": "メッセージのスキーマの版", "$ref": "#/$defs/schema_version" },
        "ops": {
          "description": "このコア（wasm ではこのモジュール）で使える op の名前",
          "type": "array",
          "items": { "type": "string" }
        },
        "formats": {
          "description": "読み書きできる形式",
          "type": "array",
          "items": { "$ref": "#/$defs/format" }
        }
      },
      "required": ["package", "abi", "schema", "ops", "formats"],
      "additionalProperties": false
    },
    "schema_version": {
      "description": "メッセージのスキーマの版。大版は要求と応答の v、小版は op・欄・列挙の値を足すたびに上げる",
      "type": "object",
      "properties": {
        "major": { "description": "大版", "type": "integer", "minimum": 1 },
        "minor": { "description": "小版", "type": "integer", "minimum": 0 }
      },
      "required": ["major", "minor"],
      "additionalProperties": false
    },
    "format": {
      "description": "読み書きできる形式",
      "type": "object",
      "properties": {
        "id": { "description": "形式の名前（dxf・sfc など）", "type": "string" },
        "family": { "description": "形式の系統（autocad・sxf など、決定 0008）", "type": "string" },
        "read": { "description": "読めるか", "type": "boolean" },
        "write": { "description": "書けるか", "type": "boolean" },
        "id_rules": { "description": "この形式の ID の規則の版（決定 0015）", "type": "integer", "minimum": 1 }
      },
      "required": ["id", "family", "read", "write", "id_rules"],
      "additionalProperties": false
    },
    "open_request": {
      "description": "入力を読んで、文書を作る。形式は入力から判定する",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "open" },
        "input": { "description": "読む入力の名前。zm_push で渡したもの", "type": "string" },
        "doc": { "description": "作る文書の名前。書かなければ入力の名前", "type": "string" }
      },
      "required": ["op", "input"],
      "unevaluatedProperties": false
    },
    "open_result": {
      "description": "作った文書",
      "type": "object",
      "properties": {
        "doc": { "description": "文書の名前", "type": "string" },
        "format": { "description": "判定した形式の名前", "type": "string" }
      },
      "required": ["doc", "format"],
      "additionalProperties": false
    },
    "close_request": {
      "description": "文書と入力を捨てる。名指ししたものが 1 つでもなければ、何も捨てない",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "close" },
        "docs": {
          "description": "捨てる文書の名前",
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "description": "捨てる入力の名前",
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["op"],
      "unevaluatedProperties": false
    },
    "close_result": {
      "description": "捨てたこと。中身はない",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "describe_request": {
      "description": "診断の文を、カタログから組み立てる（決定 0009）",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "describe" },
        "catalog": {
          "description": "カタログの入力の名前。zm_push で渡したもの。書かなければ、code と値をそのまま文にする",
          "type": "string"
        },
        "diagnostics": {
          "description": "文にする診断。応答で受け取ったもの",
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      },
      "required": ["op", "diagnostics"],
      "unevaluatedProperties": false
    },
    "describe_result": {
      "description": "診断の文",
      "type": "object",
      "properties": {
        "texts": {
          "description": "診断ごとの文。要求の diagnostics と同じ順。カタログにない code は、code と値をそのまま書く",
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["texts"],
      "additionalProperties": false
    },
    "drawing_request": {
      "description": "開いた文書を図面モデル（L2、決定 0022）に変換し、その要約を返す。ネイティブと wasm の出力の一致を、適合試験で比べるためにも使う（決定 0007）",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "drawing" },
        "doc": { "description": "文書の名前。open で作ったもの", "type": "string" }
      },
      "required": ["op", "doc"],
      "unevaluatedProperties": false
    },
    "drawing_result": {
      "description": "図面モデルの要約。移さなかった図形と値は、診断で返す",
      "type": "object",
      "properties": {
        "hash": {
          "description": "文書のハッシュ。open に渡したバイト列から作る。変更の一覧の前提条件に使う（v1: と 32 桁の 16 進、決定 0156）",
          "type": "string"
        },
        "spaces": {
          "description": "実寸の空間。モデルの順",
          "type": "array",
          "items": { "$ref": "#/$defs/space_summary" }
        },
        "sheets": {
          "description": "用紙。モデルの順",
          "type": "array",
          "items": { "$ref": "#/$defs/sheet_summary" }
        }
      },
      "required": ["spaces", "sheets"],
      "additionalProperties": false
    },
    "space_summary": {
      "description": "実寸の空間の要約",
      "type": "object",
      "properties": {
        "id": { "description": "空間の ID（space/0）。entities の要素の ID の始まりと同じ（決定 0156）", "type": "string" },
        "unit": { "description": "文書の単位", "$ref": "#/$defs/unit" },
        "elements": { "description": "要素の数", "$ref": "#/$defs/element_counts" },
        "extent": {
          "description": "線分の端点と文字の基点を囲む範囲。文書の単位。要素がなければ持たない",
          "$ref": "#/$defs/extent"
        }
      },
      "required": ["unit", "elements"],
      "additionalProperties": false
    },
    "sheet_summary": {
      "description": "用紙の要約",
      "type": "object",
      "properties": {
        "id": {
          "description": "用紙の ID。LAYOUT がハンドルを持てば sheet/h22、なければ読んだ順の番号（sheet/0）。entities の要素の ID の始まりと同じ（決定 0156）",
          "type": "string"
        },
        "name": {
          "description": "元の形式の用紙の名前（DXF・DWG のレイアウトの名前）。翻訳しない。なければ持たない",
          "type": "string"
        },
        "size": {
          "description": "用紙の幅と高さ（mm）。分からなければ持たない",
          "type": "array",
          "items": { "type": "number" }
        },
        "elements": { "description": "要素の数", "$ref": "#/$defs/element_counts" },
        "views": { "description": "ビューの数", "type": "integer", "minimum": 0 },
        "extent": {
          "description": "線分の端点と文字の基点を囲む範囲。用紙の mm。要素がなければ持たない",
          "$ref": "#/$defs/extent"
        }
      },
      "required": ["elements", "views"],
      "additionalProperties": false
    },
    "unit": {
      "description": "実寸の単位",
      "type": "string",
      "enum": ["millimeter", "centimeter", "meter", "inch", "foot", "unknown"]
    },
    "element_counts": {
      "description": "種類ごとの要素の数",
      "type": "object",
      "properties": {
        "lines": { "description": "線分", "type": "integer", "minimum": 0 },
        "texts": { "description": "文字", "type": "integer", "minimum": 0 }
      },
      "required": ["lines", "texts"],
      "additionalProperties": false
    },
    "extent": {
      "description": "点を囲む、軸に沿った長方形",
      "type": "object",
      "properties": {
        "min_x": { "description": "X の最小", "type": "number" },
        "min_y": { "description": "Y の最小", "type": "number" },
        "max_x": { "description": "X の最大", "type": "number" },
        "max_y": { "description": "Y の最大", "type": "number" }
      },
      "required": ["min_x", "min_y", "max_x", "max_y"],
      "additionalProperties": false
    },
    "entities_request": {
      "description": "開いた文書を図面モデル（L2、決定 0022）に変換し、要素の一覧を返す。実寸の空間、用紙の順に、それぞれの要素を入力の順に並べる（決定 0117）",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "entities" },
        "doc": { "description": "文書の名前。open で作ったもの", "type": "string" },
        "offset": {
          "description": "返す最初の要素の位置。前の応答の next_offset を渡す。書かなければ 0",
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "description": "返す要素の数の上限。書かなければ 1000",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "fields": {
          "description": "返す欄の名前。1 つ以上で、重ねない。id は書かなくても返す。書かなければ id・kind・layer・source を返す（決定 0118）",
          "type": "array",
          "items": { "$ref": "#/$defs/entity_field" }
        },
        "region": {
          "description": "[最小の X, 最小の Y, 最大の X, 最大の Y]。範囲がこの長方形と重なるか接する要素だけを返す。空間か用紙それぞれの座標で比べる（決定 0118）",
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "required": ["op", "doc"],
      "unevaluatedProperties": false
    },
    "entities_result": {
      "description": "要素の一覧の一部。移さなかった図形と値は、診断で返す",
      "type": "object",
      "properties": {
        "items": {
          "description": "offset から limit 個までの要素",
          "type": "array",
          "items": { "$ref": "#/$defs/entity" }
        },
        "total": { "description": "全体の要素の数", "type": "integer", "minimum": 0 },
        "next_offset": {
          "description": "続きの最初の要素の位置。続きがなければ持たない",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["items", "total"],
      "additionalProperties": false
    },
    "entity": {
      "description": "図面モデルの要素",
      "type": "object",
      "properties": {
        "id": {
          "description": "空間か用紙と、出所で作る ID（space/0/h2F、space/0/r12、sheet/1/b4096 など）。出所の部分は、形式が持つ鍵（ハンドル）があれば鍵で作り、書き戻しても前の要素が増えても変わらない。同じバイト列には、どの版でも同じ ID を返す（決定 0117・0156）",
          "type": "string"
        },
        "kind": { "description": "形の種類", "$ref": "#/$defs/entity_kind" },
        "layer": { "description": "レイヤの元の名前。翻訳しない。図面モデルにレイヤがなければ持たない", "type": "string" },
        "source": { "description": "元の形式のレコード", "$ref": "#/$defs/source" },
        "bbox": {
          "description": "形の定義から求めた範囲。文字の字形・線の太さ・記号の中身は含めない。囲む点がなければ持たない（決定 0118）",
          "$ref": "#/$defs/extent"
        },
        "hash": {
          "description": "要素のレイヤ・スタイル・形のハッシュ。出所の位置は含めない。変更の前提条件に使う（v1: と 32 桁の 16 進、決定 0156）",
          "type": "string"
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "entity_field": {
      "description": "entities で返す要素の欄（決定 0118）",
      "type": "string",
      "enum": ["id", "kind", "layer", "source", "bbox", "hash"]
    },
    "entity_kind": {
      "description": "要素の形の種類（決定 0022）",
      "type": "string",
      "enum": [
        "line",
        "circle",
        "curve",
        "polyline",
        "text",
        "formatted_text",
        "dimension",
        "leader",
        "callout",
        "table",
        "underlay",
        "symbol",
        "hatch"
      ]
    },
    "apply_request": {
      "description": "開いた文書に、変更の一覧を当てて書き戻す（決定 0139・0156）。要素は、entities が返す ID とハッシュで指す。どれか 1 つでも当てられなければ、何も変えない。当てたら、文書を書き戻したものに替え、書き戻したファイルを blobs で返す。小版 7 から",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "apply" },
        "doc": { "description": "文書の名前。open で作ったもの", "type": "string" },
        "hash": {
          "description": "読んだときの文書のハッシュ（drawing の hash）。書けば、今の文書と同じときだけ当てる",
          "type": "string"
        },
        "edits": {
          "description": "変更。並べた順に当てる",
          "type": "array",
          "items": { "$ref": "#/$defs/edit" }
        }
      },
      "required": ["op", "doc", "edits"],
      "unevaluatedProperties": false
    },
    "apply_result": {
      "description": "当てた変更の結果。書き戻したファイルは blobs の file で返す",
      "type": "object",
      "properties": {
        "applied": {
          "description": "変更ごとの結果。要求の edits と同じ順",
          "type": "array",
          "items": { "$ref": "#/$defs/applied" }
        },
        "hash": {
          "description": "書き戻した文書のハッシュ。次の apply の前提条件に使う",
          "type": "string"
        }
      },
      "required": ["applied", "hash"],
      "additionalProperties": false
    },
    "applied": {
      "description": "当てた変更 1 つの結果",
      "type": "object",
      "properties": {
        "id": {
          "description": "変えた要素の、書き戻した後の ID。除いたときと、ID を決められないときは持たない",
          "type": "string"
        },
        "hash": {
          "description": "変えた要素の、書き戻した後のハッシュ。id があるときに持つ",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edit": {
      "description": "要素 1 つへの変更。kind の値で形が決まる",
      "oneOf": [
        { "$ref": "#/$defs/restyle_edit" },
        { "$ref": "#/$defs/transform_edit" },
        { "$ref": "#/$defs/remove_edit" }
      ]
    },
    "restyle_edit": {
      "description": "要素のレイヤ・色・線種・線種の倍率・線幅のうち、書いたものだけを変える。形は変えない",
      "type": "object",
      "properties": {
        "kind": { "description": "変更の種類", "const": "restyle" },
        "id": { "description": "変える要素の ID。entities が返したもの", "type": "string" },
        "hash": { "description": "読んだときの要素のハッシュ。entities が返したもの", "type": "string" },
        "layer": { "description": "レイヤの元の名前。図面にあるレイヤで、名前が 1 つに決まるもの。layer_id と一緒には書かない", "type": "string" },
        "layer_id": { "description": "レイヤの ID。tables が返したもの。小版 8 から", "type": "string" },
        "color": { "description": "色", "$ref": "#/$defs/color_change" },
        "line_type": { "description": "線種", "$ref": "#/$defs/line_type_change" },
        "line_type_scale": { "description": "要素の線種の倍率", "type": "number" },
        "line_weight": { "description": "線幅", "$ref": "#/$defs/line_weight_change" }
      },
      "required": ["kind", "id", "hash"],
      "additionalProperties": false
    },
    "transform_edit": {
      "description": "要素を、アフィン変換で動かす。AutoCAD の系統では、図形とともに動く XDATA と記号の属性も同じ変換で直す。変換した形を元の種類で表せなければ当てない",
      "type": "object",
      "properties": {
        "kind": { "description": "変更の種類", "const": "transform" },
        "id": { "description": "動かす要素の ID。entities が返したもの", "type": "string" },
        "hash": { "description": "読んだときの要素のハッシュ。entities が返したもの", "type": "string" },
        "matrix": {
          "description": "[a, b, c, d, e, f]。要素の空間か用紙の点 (x, y) を (a x + b y + c, d x + e y + f) に写す",
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "required": ["kind", "id", "hash", "matrix"],
      "additionalProperties": false
    },
    "remove_edit": {
      "description": "要素を除く",
      "type": "object",
      "properties": {
        "kind": { "description": "変更の種類", "const": "remove" },
        "id": { "description": "除く要素の ID。entities が返したもの", "type": "string" },
        "hash": { "description": "読んだときの要素のハッシュ。entities が返したもの", "type": "string" }
      },
      "required": ["kind", "id", "hash"],
      "additionalProperties": false
    },
    "inherit": {
      "description": "値を継承する先。layer はレイヤから、block は要素を置いた記号の配置から",
      "type": "string",
      "enum": ["layer", "block"]
    },
    "color_change": {
      "description": "新しい色。inherit か、aci と rgb の少なくとも一方のどちらかを書く",
      "type": "object",
      "properties": {
        "inherit": { "description": "継承する先", "$ref": "#/$defs/inherit" },
        "aci": { "description": "AutoCAD の色の番号（1〜255）", "type": "integer", "minimum": 1, "maximum": 255 },
        "rgb": {
          "description": "[赤, 緑, 青]。それぞれ 0〜255",
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      },
      "additionalProperties": false
    },
    "line_type_change": {
      "description": "新しい線種。inherit・name・id のどれか 1 つを書く",
      "type": "object",
      "properties": {
        "inherit": { "description": "継承する先", "$ref": "#/$defs/inherit" },
        "name": { "description": "線種の元の名前。図面にある線種で、名前が 1 つに決まるもの", "type": "string" },
        "id": { "description": "線種の ID。tables が返したもの。小版 8 から", "type": "string" }
      },
      "additionalProperties": false
    },
    "line_weight_change": {
      "description": "新しい線幅。inherit・mm・default のどれか 1 つを書く",
      "type": "object",
      "properties": {
        "inherit": { "description": "継承する先", "$ref": "#/$defs/inherit" },
        "mm": { "description": "用紙の上の幅（mm）。0 以上", "type": "number" },
        "default": { "description": "true なら、文書の既定の線幅", "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tables_request": {
      "description": "開いた文書を図面モデル（L2）に変換し、レイヤと線種の表の項目を返す（決定 0156）。小版 8 から",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/request_common" }],
      "properties": {
        "op": { "description": "op の名前", "const": "tables" },
        "doc": { "description": "文書の名前。open で作ったもの", "type": "string" }
      },
      "required": ["op", "doc"],
      "unevaluatedProperties": false
    },
    "tables_result": {
      "description": "表の項目。図面モデルの順",
      "type": "object",
      "properties": {
        "layers": {
          "description": "レイヤ",
          "type": "array",
          "items": { "$ref": "#/$defs/table_item" }
        },
        "line_types": {
          "description": "線種",
          "type": "array",
          "items": { "$ref": "#/$defs/table_item" }
        }
      },
      "required": ["layers", "line_types"],
      "additionalProperties": false
    },
    "table_item": {
      "description": "表の項目",
      "type": "object",
      "properties": {
        "id": {
          "description": "ID。表のレコードがハンドルを持てば layer/h10・line-type/h14、なければ読んだ順の番号（layer/2）。書き戻しても変わらない（決定 0156）",
          "type": "string"
        },
        "name": { "description": "元の名前。翻訳しない", "type": "string" },
        "hash": { "description": "項目のハッシュ（v1: と 32 桁の 16 進、決定 0156）", "type": "string" }
      },
      "required": ["id", "name", "hash"],
      "additionalProperties": false
    },
    "source": {
      "description": "要素の出所。L1 のレコードの番号かバイト範囲（決定 0008）と、形式が持つ鍵（決定 0156）。ファイルから読んでいない要素は、レコードの番号もバイト範囲も持たない",
      "type": "object",
      "properties": {
        "record": { "description": "L1 のレコードの番号", "type": "integer", "minimum": 0 },
        "bytes": { "description": "L1 のバイト範囲", "$ref": "#/$defs/byte_range" },
        "handle": { "description": "AutoCAD の系統のハンドル。大文字の 16 進。書き戻しても変わらない", "type": "string" },
        "instance": { "description": "SXF のインスタンスの番号（#n の n）。10 進の文字列。小版 6 から", "type": "string" }
      },
      "additionalProperties": false
    },
    "response": {
      "description": "応答。失敗したときも同じ形で、result を持たない",
      "type": "object",
      "properties": {
        "v": { "description": "メッセージのスキーマの大版", "type": "integer", "minimum": 1 },
        "result": { "description": "op ごとの結果（<op>_result の形）。失敗したときは持たない" },
        "diagnostics": {
          "description": "診断。入力の順",
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "blobs": {
          "description": "バイナリの結果。zm_take で取り出す。次の zm_call で捨てる",
          "type": "array",
          "items": { "$ref": "#/$defs/blob" }
        }
      },
      "required": ["v", "diagnostics", "blobs"],
      "additionalProperties": false
    },
    "diagnostic": {
      "description": "診断。人向けの文は持たず、文は describe で組み立てる（決定 0009）",
      "type": "object",
      "properties": {
        "code": { "description": "変わらない名前（budget.records.exceeded など）。catalog/codes.toml にある", "type": "string" },
        "severity": { "description": "重さ。code ごとに決まる", "$ref": "#/$defs/severity" },
        "fidelity": { "description": "変換の結果の段。code ごとに決まる。変換の結果を表さない code では持たない", "$ref": "#/$defs/fidelity" },
        "count": { "description": "まとめた件数", "type": "integer", "minimum": 1 },
        "at": {
          "description": "場所。入力の順に先頭の数件",
          "type": "array",
          "items": { "$ref": "#/$defs/place" }
        },
        "cite": { "description": "仕様の節", "$ref": "#/$defs/cite" },
        "params": {
          "description": "文に差し込む値。名前と型は code ごとに台帳が決める。2^53 − 1 を超える整数は文字列にする",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/param_value" }
        }
      },
      "required": ["code", "severity", "count", "at", "params"],
      "additionalProperties": false
    },
    "severity": {
      "description": "診断の重さ（決定 0009）。info は何も失っていない、warning は結果を使える、error は失敗した",
      "type": "string",
      "enum": ["info", "warning", "error"]
    },
    "fidelity": {
      "description": "変換の結果の段のうち、`native` 以外のもの（決定 0009）",
      "type": "string",
      "enum": ["equivalent", "approximated", "drawn", "dropped"]
    },
    "place": {
      "description": "診断の場所。ID と、L1 のレコード・バイト範囲（決定 0008 の出所）",
      "type": "object",
      "properties": {
        "id": { "description": "ID", "type": "string" },
        "record": { "description": "L1 のレコードの番号", "type": "integer", "minimum": 0 },
        "bytes": { "description": "L1 のバイト範囲", "$ref": "#/$defs/byte_range" }
      },
      "additionalProperties": false
    },
    "byte_range": {
      "description": "バイト範囲（start から end の手前まで）",
      "type": "object",
      "properties": {
        "start": { "description": "先頭の位置", "type": "integer", "minimum": 0 },
        "end": { "description": "終わりの位置（含まない）", "type": "integer", "minimum": 0 }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "cite": {
      "description": "仕様の節。仕様の本文は写さない",
      "type": "object",
      "properties": {
        "spec": { "description": "仕様の一覧での名前", "type": "string" },
        "section": { "description": "節", "type": "string" }
      },
      "required": ["spec", "section"],
      "additionalProperties": false
    },
    "param_value": {
      "description": "診断の値。数か文字列",
      "oneOf": [
        { "description": "数", "type": "number" },
        { "description": "文字列。図面に記録された名前、列挙の値のキー、2^53 − 1 を超える整数", "type": "string" }
      ]
    },
    "blob": {
      "description": "バイナリの結果",
      "type": "object",
      "properties": {
        "id": { "description": "番号。zm_take に渡す", "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "kind": { "description": "種類", "$ref": "#/$defs/blob_kind" },
        "size": { "description": "バイト数", "type": "integer", "minimum": 0 }
      },
      "required": ["id", "kind", "size"],
      "additionalProperties": false
    },
    "blob_kind": {
      "description": "バイナリの結果の種類。file は書き出したファイル、image は描いた画像、scene はシーン（#6 で決める配置）、arrow は表（Arrow の IPC ストリーム。ネイティブでは zm_take_arrow でも取り出せる）",
      "type": "string",
      "enum": ["file", "image", "scene", "arrow"]
    },
    "session_options": {
      "description": "zm_session_new に渡す設定。渡さなければ既定の設定",
      "type": "object",
      "properties": {
        "v": { "description": "メッセージのスキーマの大版。今は 1", "type": "integer", "minimum": 1 },
        "engine": { "description": "実行の形。書かなければ、ネイティブのライブラリでは `native`、wasm のモジュールでは `wasm`（決定 0013）", "$ref": "#/$defs/engine" }
      },
      "required": ["v"],
      "additionalProperties": false
    },
    "engine": {
      "description": "実行の形（決定 0013）。`native` はプロセスの中でコアを動かす、`process` は子プロセスの CLI に送る、`wasm` は wasm のモジュールで動かす",
      "type": "string",
      "enum": ["native", "process", "wasm"]
    },
    "catalog": {
      "description": "describe に使うカタログのファイル。catalog/<言語>.toml から生成し、zm_push で渡す（決定 0009）",
      "type": "object",
      "properties": {
        "v": { "description": "カタログの形の大版。今は 1", "type": "integer", "minimum": 1 },
        "lang": { "description": "言語（ja・en）", "type": "string" },
        "package": { "description": "パッケージの版。コアと同じ版で出す", "type": "string" },
        "number": { "description": "数の書き方", "$ref": "#/$defs/number_format" },
        "codes": {
          "description": "code ごとの文のひな形。{名前} に値が、{count} にまとめた件数が入る",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["v", "lang", "package", "number", "codes"],
      "additionalProperties": false
    },
    "number_format": {
      "description": "文に差し込む数の書き方。OS のロケールは使わない（決定 0009）",
      "type": "object",
      "properties": {
        "group_separator": { "description": "整数部を 3 桁ごとに区切る文字。空なら区切らない", "type": "string" },
        "decimal_separator": { "description": "小数点の文字", "type": "string" }
      },
      "required": ["group_separator", "decimal_separator"],
      "additionalProperties": false
    }
  }
}
