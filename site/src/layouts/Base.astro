---
import '@digital-go-jp/design-tokens/dist/tokens.css';
import '@fontsource-variable/noto-sans-jp/wght.css';
import '@fontsource/noto-sans-mono/400.css';
import '../styles/global.css';
import { nav, releaseVersion, repo } from '../data/site';

interface Props {
  // 下層のページの名前。トップでは渡さない。
  title?: string;
  description?: string;
  // 検索に載せないページ（404 など）。正規の URL も書かない。
  noindex?: boolean;
}

const site = '日本の建設のデータを読み書きするライブラリ群';
const {
  title,
  noindex = false,
  description = 'zumen は、SXF・Jw_cad・DXF・DWG から BIM・土木・電子納品まで、日本の建設のデータを読み書きする、寛容なライセンスのライブラリ群です。',
} = Astro.props;
const fullTitle = title ? `${title}｜zumen` : `zumen｜${site}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <!-- CSP3 §3.3。404 で HTTP ヘッダーが付かなくても、後から挿入されたスクリプトを拒否する。資産の link より前に置く。 -->
    <meta http-equiv="Content-Security-Policy" content="script-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0017c1" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="ja_JP" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>

    <div class="notice" role="note" aria-label="公開版の案内">
      <div class="wrap notice-inner">
        <span class="notice-badge">v{releaseVersion} 公開</span>
        <span class="notice-text">配布先と使い方は<a href="/platforms/#packages">対応環境</a>、機能の範囲は<a href="/formats/">対応形式</a>で案内しています。</span>
      </div>
    </div>

    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="logo" href="/" aria-label="zumen トップ">
          <img class="logo-mark" src="/favicon.svg" width="36" height="36" alt="" />
          <span class="logo-text"><strong>zumen</strong><span>図面の読み書きの基盤</span></span>
        </a>
        <nav class="gnav" aria-label="サイト内">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="header-cta" href={repo} aria-label="GitHub で見る">
          <svg class="icon-gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="logo" href="/">
              <img class="logo-mark" src="/favicon.svg" width="36" height="36" alt="" />
              <span class="logo-text"><strong>zumen</strong><span>図面の読み書きの基盤</span></span>
            </a>
            <p class="footer-desc">日本の建設のデータを読み書きする、オープンソースのライブラリ群です。図面は外へ出さず、手元の環境で処理します。</p>
          </div>
          <div class="footer-col">
            <p class="footer-heading" lang="en">Navigation</p>
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-heading" lang="en">Project</p>
            <ul>
              <li><a href={repo}>GitHub リポジトリ</a></li>
              <li><a href={`${repo}/releases/tag/v${releaseVersion}`}>v{releaseVersion} リリース</a></li>
              <li><a href={`${repo}/blob/main/SECURITY.md`}>脆弱性の報告</a></li>
              <li><a href={`${repo}/blob/main/CODE_OF_CONDUCT.md`}>行動規範</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-note">
          <p>zumen は MIT License または Apache License 2.0 で提供します。</p>
          <p class="footer-meta" lang="en">zumen.dev · v{releaseVersion}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
