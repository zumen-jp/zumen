---
import '@digital-go-jp/design-tokens/dist/tokens.css';
import '@fontsource-variable/noto-sans-jp/wght.css';
import '@fontsource/noto-sans-mono/400.css';
import '../styles/global.css';
import { nav, releaseVersion, repo } from '../data/site';

interface Props {
  // 下層のページの名前。トップでは渡さない。
  title?: string;
  description?: string;
  // 検索に載せないページ（404 など）。正規の URL も書かない。
  noindex?: boolean;
}

const site = '日本の建設のデータを読み書きするライブラリ群';
const { title, noindex = false, description = 'zumen は、SXF・Jw_cad・DXF・DWG から BIM・土木・電子納品まで、日本の建設のデータを読み書きする、寛容なライセンスのライブラリ群です。' } = Astro.props;
const fullTitle = title ? `${title}｜zumen` : `zumen｜${site}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <!-- CSP3 §3.3。404 で HTTP ヘッダーが付かなくても、後から挿入されたスクリプトを拒否する。資産の link より前に置く。 -->
    <meta http-equiv="Content-Security-Policy" content="script-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0017c1" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="ja_JP" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>

    <p class="notice">
      <span class="wrap"><strong>v{releaseVersion} 公開</strong>配布先と使い方は<a href="/platforms/#packages">対応環境</a>、機能の範囲は<a href="/formats/">対応形式</a>で案内しています。</span>
    </p>

    <header class="masthead">
      <div class="wrap">
        <a class="logo" href="/" aria-label="zumen トップ">
          <img class="logo-mark" src="/favicon.svg" width="40" height="40" alt="" />
          <span class="logo-text"><strong>zumen</strong><span>図面の読み書きの基盤</span></span>
        </a>
        <nav class="gnav" aria-label="サイト内">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="btn btn-secondary header-cta" href={repo}>GitHub で見る</a>
      </div>
    </header>


    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <a class="logo" href="/">
            <img class="logo-mark" src="/favicon.svg" width="40" height="40" alt="" />
            <span class="logo-text"><strong>zumen</strong><span>図面の読み書きの基盤</span></span>
          </a>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
          <ul>
            <li><a href={repo}>GitHub</a></li>
            <li><a href={`${repo}/blob/main/SECURITY.md`}>脆弱性の報告</a></li>
            <li><a href={`${repo}/blob/main/CODE_OF_CONDUCT.md`}>行動規範</a></li>
          </ul>
        </div>
        <div class="footer-note">
          <p>zumen は MIT License または Apache License 2.0 で提供します。</p>
        </div>
      </div>
    </footer>
  </body>
</html>
