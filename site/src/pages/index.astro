---
import FaqList from '../components/FaqList.astro';
import FormatTable from '../components/FormatTable.astro';
import NewsList from '../components/NewsList.astro';
import PlanDrawing from '../components/PlanDrawing.astro';
import SectionHead from '../components/SectionHead.astro';
import { faqs, formats, hostApps, legacy, news, repo } from '../data/site';
import Base from '../layouts/Base.astro';

const points = [
  {
    title: 'どこでも同じ結果',
    body: 'ブラウザー・サーバー・Python・.NET・Excel のどこから使っても、同じ図面から同じ結果を返します。部署やシステムごとに結果が食い違いません。',
  },
  {
    title: '日本の実務の形式を優先',
    body: '電子納品の SXF、Jw_cad の JWW、AutoCAD の DXF・DWG を先に扱います。日本語の文字や、国土交通省の基準にも合わせます。',
  },
  {
    title: '図面を外へ出さない',
    body: '図面を外部のサービスへ送らず、手元のパソコンや社内のサーバーで読みます。読めなかったものは、黙って捨てずに報告します。',
  },
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-body">
      <div>
        <p class="status-chip">オープンソース（MIT・Apache-2.0）</p>
        <h1 id="hero-title">日本の図面を、<br /><em>どの言語からも</em>、<br />同じ結果で。</h1>
        <p class="hero-lead">
          zumen は、SXF・Jw_cad・DXF・DWG から BIM・土木・電子納品まで、日本の建設のデータを読み書きするライブラリ群です。Rust の 1 つの核を、ブラウザー・サーバー・Python・.NET・Excel から同じように使えます。
        </p>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href="/features/">特長を見る</a>
          <a class="btn btn-secondary btn-lg" href="/formats/">対応形式を見る</a>
        </div>
      </div>
      <PlanDrawing />
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="news-title">
    <div class="wrap">
      <div class="news-box-head">
        <div class="section-head">
          <span class="shoulder" lang="en">News</span>
          <h2 id="news-title">お知らせ</h2>
        </div>
        <a class="btn btn-text arrow" href="/news/">一覧を見る</a>
      </div>
      <NewsList items={news.slice(0, 3)} />
    </div>
  </section>

  <section class="section" aria-labelledby="points-title">
    <div class="wrap">
      <SectionHead id="points-title" title="zumen の 3 つの特長" en="Features" />
      <ol class="cards">
        {
          points.map((p, i) => (
            <li class="card">
              <span class="card-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="section-foot"><a class="btn btn-secondary" href="/features/">特長と仕組みを詳しく見る</a></p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="formats-title">
    <div class="wrap">
      <SectionHead id="formats-title" title="対応形式の早見表" en="Formats" />
      <FormatTable items={formats.filter((f) => f.top)} />
      <p class="section-foot"><a class="btn btn-secondary" href="/formats/">すべての形式を見る</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="apps-title">
    <div class="wrap">
      <SectionHead id="apps-title" title="いつものソフトから使える" en="Integrations" />
      <p>各言語のパッケージを通して、次のソフトの中から使えるようにします（予定）。</p>
      <ul class="chips chips-lg">{hostApps.map((a) => <li>{a}</li>)}</ul>
      <p class="section-foot"><a class="btn btn-secondary" href="/platforms/">対応環境を見る</a></p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="faq-title">
    <div class="wrap">
      <SectionHead id="faq-title" title="よくある質問" en="FAQ" />
      <FaqList items={faqs.filter((f) => f.top)} />
      <p class="section-foot"><a class="btn btn-secondary" href="/faq/">質問をすべて見る</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta">
        <h2 id="cta-title">開発の進み具合は、GitHub で公開しています</h2>
        <p>設計・決めたこと・次の作業を、すべて GitHub で見られます。今すぐ図面を読み書きしたい場合は、旧版を使ってください。</p>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={repo}>GitHub で見る</a>
          <a class="btn btn-secondary btn-lg" href={legacy}>旧版を使う</a>
        </div>
      </div>
    </div>
  </section>
</Base>
