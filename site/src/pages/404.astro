---
// 存在しないパスのページ。Cloudflare Pages は、dist/404.html があれば、見つからないパスに状態 404 で返す（#688）。
import PageHeader from '../components/PageHeader.astro';
import { webEditor } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません" description="お探しのページは、移動したか、まだありません。" noindex>
  <PageHeader en="404 Not Found" title="ページが見つかりません" lead="お探しのページは、移動したか、まだありません。" />
  <section class="section">
    <div class="wrap">
      <p class="prose">URL を確かめるか、トップページからお探しください。</p>
      <div class="actions">
        <a class="btn btn-primary arrow" href="/">トップページへ</a>
        <a class="btn btn-secondary" href={webEditor}>Web 図面エディターを開く</a>
      </div>
    </div>
  </section>
</Base>
