---
import SitePlan from '../components/drawings/SitePlan.astro';
import SectionHead from '../components/SectionHead.astro';
import { hostApps, releasedSource, releaseUrl, releaseVersion, repo } from '../data/site';
import Page from '../layouts/Page.astro';

const os = [
  ['Windows', 'Windows 10、Windows Server 2016（x64・x86・ARM64）'],
  ['macOS', 'macOS 11（arm64）、macOS 10.12（x64）'],
  ['Linux', '目標は glibc 2.28（x64・arm64）。v0.2.0 の配布物の条件は下の注記を参照'],
  ['iOS・iPadOS', 'iOS 15'],
  ['Android', 'Android 7.0（API 24）'],
  ['ブラウザー', 'Chrome・Edge 96、Firefox 91、Safari 15.1'],
  ['Node.js', '22'],
  ['Python', '3.9（Rhino 8・Dynamo 3.x に合わせる）'],
  ['.NET', '.NET Framework 4.8、.NET 8 以降（Revit・AutoCAD 2024 に合わせる）'],
];

const packages = [
  { language: 'Rust', name: 'zumen', url: 'https://crates.io/crates/zumen/0.2.0', guide: 'https://docs.rs/zumen/0.2.0/zumen/' },
  { language: 'TypeScript・JavaScript', name: '@zumen-jp/zumen', url: 'https://www.npmjs.com/package/@zumen-jp/zumen/v/0.2.0', guide: releasedSource('bindings/js/README.md') },
  { language: 'Python', name: 'zumen', url: 'https://pypi.org/project/zumen/0.2.0/', guide: releasedSource('bindings/python/README.md') },
  { language: '.NET', name: 'Zumen', url: 'https://www.nuget.org/packages/Zumen/0.2.0', guide: releasedSource('bindings/dotnet/README.md') },
  { language: 'C・C++', name: 'C ABI・ヘッダー', url: releaseUrl, guide: releasedSource('bindings/c/README.md') },
  { language: 'CLI・MCP', name: 'zumen', url: releaseUrl, guide: releasedSource('bindings/cli/README.md') },
];
---

<Page
  description="言語の Tier、OS とブラウザーの下限、使えるホストアプリ、公開済みのパッケージです。"
  toc={[
    { id: 'languages', label: '言語の Tier' },
    { id: 'requirements', label: 'OS とブラウザー' },
    { id: 'host-apps', label: 'ホストアプリ' },
    { id: 'packages', label: 'パッケージ' },
  ]}
>
  <SitePlan slot="drawing" />

  <section class="section" id="languages" aria-labelledby="languages-title">
    <div class="wrap">
      <SectionHead id="languages-title" title="言語の Tier" en="Languages" />
      <div class="cards">
        <div class="card">
          <h3>Tier 1</h3>
          <p>その言語らしいパッケージを作り、PR ごとに適合テストを走らせ、コアと同じ日に公開します。</p>
          <ul class="chips"><li>Rust</li><li>TypeScript・JavaScript</li><li>Python</li><li>.NET</li><li>C・C++</li><li>CLI・MCP</li></ul>
        </div>
        <div class="card">
          <h3>Tier 2</h3>
          <p>生成したパッケージを作り、適合テストを毎晩走らせます。パッケージの公開は準備中です。</p>
          <ul class="chips"><li>Java・Kotlin</li><li>Swift</li><li>Go</li><li>Dart</li><li>VBA</li></ul>
        </div>
        <div class="card">
          <h3>Tier 3</h3>
          <p>C ABI・wasm・CLI・HTTP を使う手順とサンプルを用意します。</p>
          <ul class="chips"><li>Ruby</li><li>PHP</li><li>R</li><li>Julia</li><li>MATLAB</li><li>AutoLISP</li><li>PowerShell</li><li>ほか</li></ul>
        </div>
      </div>
      <p class="note">Tier の決め方は<a href={`${repo}/blob/main/docs/support.md`}>対応する環境</a>にあります。</p>
    </div>
  </section>

  <section class="section section-alt" id="requirements" aria-labelledby="requirements-title">
    <div class="wrap">
      <SectionHead id="requirements-title" title="OS とブラウザー" en="Requirements" />
      <div class="table-scroll">
        <table class="table spec">
          <tbody>{os.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">ブラウザーの下限は wasm と JavaScript の互換性の資料に基づきます。下限の実機は未確認です。根拠と CI での確かめ方は<a href={`${repo}/blob/main/docs/support.md`}>対応する環境</a>にあります。</p>
      <p class="note">表はプロジェクトが対象にする環境です。v{releaseVersion} のネイティブ配布物は Windows（x86・x64・ARM64）・macOS（x64・arm64）・GNU Linux（x64・arm64）向けです。musl・iOS・Android のバイナリはまだ配布していません。</p>
      <p class="note">Linux の Python wheel は glibc 2.35 以降が必要です。CLI・共有ライブラリは glibc 2.34 以降が必要で、2.28 では動きません。2.34 の実環境での動作は未確認です。計画の下限に合わせる修正は<a href={`${repo}/issues/789`}>#789</a>で進めています。ブラウザーや Node.js の wasm は、この glibc の制約を受けません。</p>
    </div>
  </section>

  <section class="section" id="host-apps" aria-labelledby="host-apps-title">
    <div class="wrap">
      <SectionHead id="host-apps-title" title="使えるホストアプリ（予定）" en="Host apps" />
      <ul class="chips chips-lg">{hostApps.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <section class="section section-alt" id="packages" aria-labelledby="packages-title">
    <div class="wrap">
      <SectionHead id="packages-title" title={`公開済みのパッケージ（v${releaseVersion}）`} en="Packages" />
      <div class="table-scroll">
        <table class="table spec">
          <tbody>{packages.map((item) => <tr><th scope="row">{item.language}</th><td><a href={item.url}><code>{item.name}</code></a>（<a href={item.guide}>使い方</a>）</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">導入手順は公開版のソースに固定しています。npm は <code>@zumen-jp/zumen</code> を使います。素の <code>zumen</code> はほかの人のパッケージなので、<code>npx zumen</code> を使わないでください。React の表示部品など、リポジトリの中だけのパッケージは公開していません。</p>
    </div>
  </section>
</Page>
