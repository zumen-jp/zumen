---
import SitePlan from '../components/drawings/SitePlan.astro';
import SectionHead from '../components/SectionHead.astro';
import { hostApps, releasedSource, releaseUrl, releaseVersion, repo } from '../data/site';
import Page from '../layouts/Page.astro';

const os = [
  ['Windows', 'Windows 11、Windows Server 2022（x64・ARM64）'],
  ['macOS', 'macOS 14（Apple Silicon / arm64）'],
  ['GNU Linux', 'カーネル 5.14、glibc 2.34（x64・arm64）'],
  ['iOS・iPadOS', 'iOS 17（arm64）'],
  ['Android', 'Android 12（API 31、arm64-v8a・x86_64）'],
  ['ブラウザー', 'Chrome・Edge 113、Firefox 141（Windows）・145（macOS）、Safari 26（WebGPU・wasm simd128）'],
  ['Node.js', '24'],
  ['Python', '3.12'],
  ['.NET', '.NET 8、.NET 10（Revit・AutoCAD 2025 以降）'],
];

const releaseAsset = (name: string) => `${repo}/releases/download/v${releaseVersion}/${name}`;

const packages = [
  { language: 'Rust', name: 'crates.io の zumen', url: `https://crates.io/crates/zumen/${releaseVersion}`, guide: `https://docs.rs/zumen/${releaseVersion}/zumen/` },
  { language: 'TypeScript・JavaScript', name: '@zumen-jp/zumen', url: `https://www.npmjs.com/package/@zumen-jp/zumen/v/${releaseVersion}`, guide: releasedSource('bindings/js/README.md') },
  { language: 'Python', name: 'zumen', url: `https://pypi.org/project/zumen/${releaseVersion}/`, guide: releasedSource('bindings/python/README.md') },
  { language: '.NET', name: 'NuGet の Zumen', url: `https://www.nuget.org/packages/Zumen/${releaseVersion}`, guide: releasedSource('bindings/dotnet/README.md') },
  { language: 'C・C++', name: 'C ABI・ヘッダー', url: releaseUrl, guide: releasedSource('bindings/c/README.md') },
  { language: 'CLI・MCP', name: 'zumen', url: releaseUrl, guide: releasedSource('bindings/cli/README.md') },
  { language: 'Java・Kotlin', name: 'dev.zumen:zumen（Maven Central）', url: `https://central.sonatype.com/artifact/dev.zumen/zumen/${releaseVersion}`, guide: releasedSource('bindings/java/README.md') },
  { language: 'Swift', name: 'zumen-swift', url: `https://github.com/zumen-jp/zumen-swift/tree/v${releaseVersion}`, guide: releasedSource('bindings/swift/README.md') },
  { language: 'Go', name: 'zumen.dev/go', url: `https://pkg.go.dev/zumen.dev/go@v${releaseVersion}`, guide: releasedSource('bindings/go/README.md') },
  { language: 'Dart', name: 'pub.dev の zumen', url: `https://pub.dev/packages/zumen/versions/${releaseVersion}`, guide: releasedSource('bindings/dart/README.md') },
  { language: 'VBA（64 bit）', name: 'Excel 用 ZIP', url: releaseAsset(`zumen-vba-${releaseVersion}-win-x64.zip`), guide: releasedSource('bindings/vba/README.md') },
  { language: 'WebGPU 2D', name: '@zumen-jp/view2d', url: `https://www.npmjs.com/package/@zumen-jp/view2d/v/${releaseVersion}`, guide: releasedSource('packages/view2d/README.md') },
  { language: 'WebGPU 3D', name: '@zumen-jp/view3d', url: `https://www.npmjs.com/package/@zumen-jp/view3d/v/${releaseVersion}`, guide: releasedSource('packages/view3d/README.md') },
  { language: 'React', name: '@zumen-jp/react', url: `https://www.npmjs.com/package/@zumen-jp/react/v/${releaseVersion}`, guide: releasedSource('packages/react/README.md') },
];
---

<Page
  description="言語の Tier、OS とブラウザーの下限、使えるホストアプリ、公開済みのパッケージです。"
  toc={[
    { id: 'languages', label: '言語の Tier' },
    { id: 'requirements', label: 'OS とブラウザー' },
    { id: 'host-apps', label: 'ホストアプリ' },
    { id: 'packages', label: 'パッケージ' },
  ]}
>
  <SitePlan slot="drawing" />

  <section class="section" id="languages" aria-labelledby="languages-title">
    <div class="wrap">
      <SectionHead id="languages-title" title="言語の Tier" en="Languages" />
      <div class="cards">
        <div class="card card-tier-1">
          <span class="tier-badge tier-1">Tier 1 · コアと同日公開</span>
          <h3>Tier 1</h3>
          <p>その言語らしいパッケージを作り、PR ごとに適合テストを走らせ、コアと同じ日に公開します。</p>
          <ul class="chips"><li>Rust</li><li>TypeScript・JavaScript</li><li>Python</li><li>.NET</li><li>C・C++</li><li>CLI・MCP</li></ul>
        </div>
        <div class="card card-tier-2">
          <span class="tier-badge tier-2">Tier 2 · 毎晩の適合テスト</span>
          <h3>Tier 2</h3>
          <p>各言語のラッパーを配布し、適合テストを毎晩走らせます。</p>
          <ul class="chips"><li>Java・Kotlin</li><li>Swift</li><li>Go</li><li>Dart</li><li>VBA</li></ul>
        </div>
        <div class="card card-tier-3">
          <span class="tier-badge tier-3">Tier 3 · サンプルを毎晩検証</span>
          <h3>Tier 3</h3>
          <p>C ABI、ネイティブと WASI の CLI、HTTP で図面を開くサンプルを毎晩検証します。</p>
          <ul class="chips"><li>Ruby</li><li>PHP</li><li>PowerShell</li></ul>
        </div>
      </div>
      <p class="note">Tier の決め方は<a href={`${repo}/blob/main/docs/support.md`}>対応する環境</a>にあります。</p>
    </div>
  </section>

  <section class="section section-alt" id="requirements" aria-labelledby="requirements-title">
    <div class="wrap">
      <SectionHead id="requirements-title" title="OS とブラウザー" en="Requirements" />
      <div class="table-wrap">
        <div class="table-scroll">
          <table class="table spec">
            <tbody>{os.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      <p class="note">ブラウザーの下限は WebGPU と wasm の <code>simd128</code> が標準で使える世代に合わせています。根拠と CI での確かめ方は<a href={`${repo}/blob/main/docs/support.md`}>対応する環境</a>にあります。</p>
      <p class="note">v{releaseVersion} は 64 bit の環境が対象です。GNU Linux の Python wheel は <code>manylinux_2_34</code>、Swift 用の XCFramework は macOS と iOS の arm64 に対応しています。</p>
    </div>
  </section>

  <section class="section" id="host-apps" aria-labelledby="host-apps-title">
    <div class="wrap">
      <SectionHead id="host-apps-title" title="使えるホストアプリ（予定）" en="Host apps" />
      <ul class="chips chips-lg">{hostApps.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <section class="section section-alt" id="packages" aria-labelledby="packages-title">
    <div class="wrap">
      <SectionHead id="packages-title" title={`公開済みのパッケージ（v${releaseVersion}）`} en="Packages" />
      <div class="info-box info-box-inline">
        <p>Codex や Claude Code から図面を操作するには、<a href="/plugins/">AI プラグインの導入手順</a>をご覧ください。</p>
      </div>
      <div class="table-wrap">
        <div class="table-scroll">
          <table class="table spec pkg-table">
            <tbody>
              {
                packages.map((item) => (
                  <tr>
                    <th scope="row">{item.language}</th>
                    <td class="pkg-cell">
                      <a class="pkg-main" href={item.url}><code>{item.name}</code></a>
                      <a class="pkg-guide arrow" href={item.guide}>使い方</a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <div class="info-box">
        <p>Dart では <code>dart pub add zumen</code> でラッパーを追加します。Java と Dart では、対象環境に合う同じ版の <a href={releaseUrl}>C ABI ライブラリ</a>も用意してください。</p>
        <p>2D 表示は <code>npm install @zumen-jp/zumen @zumen-jp/view2d</code> で導入できます。3D 表示には <code>@zumen-jp/view3d</code>、React フックには <code>@zumen-jp/react</code> を追加します。素の <code>zumen</code> はほかの人のパッケージなので、<code>npx zumen</code> を使わないでください。</p>
      </div>
    </div>
  </section>
</Page>
