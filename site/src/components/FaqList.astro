---
import type { Faq } from '../data/site';

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<dl class="faq">
  {
    items.map((item) => (
      <div class="faq-item">
        <dt><span class="faq-mark" aria-hidden="true">Q</span>{item.q}</dt>
        <dd><span class="faq-mark faq-a" aria-hidden="true">A</span><span set:html={item.a} /></dd>
      </div>
    ))
  }
</dl>
