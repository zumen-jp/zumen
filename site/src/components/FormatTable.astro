---
import type { Format, Mark } from '../data/site';

interface Props {
  items: Format[];
}

const { items } = Astro.props;
const markClass: Record<Mark, string> = { '○': 'm-on', '△': 'm-half', '―': 'm-plan', '※': 'm-ext', '×': 'm-off' };
---

<ul class="legend" aria-label="記号の意味">
  <li><span class="status-badge m-on" aria-hidden="true">○</span> 使える</li>
  <li><span class="status-badge m-half" aria-hidden="true">△</span> 開発中（未公開）</li>
  <li><span class="status-badge m-plan" aria-hidden="true">―</span> 予定</li>
  <li><span class="status-badge m-ext" aria-hidden="true">※</span> コア外・別手段で対応</li>
  <li><span class="status-badge m-off" aria-hidden="true">×</span> 扱わない</li>
</ul>
<div class="table-wrap">
  <div class="table-scroll">
    <table class="table format-table">
      <thead>
        <tr><th scope="col">形式</th><th scope="col">内容</th><th scope="col" class="col-mark">読む</th><th scope="col" class="col-mark">書く</th></tr>
      </thead>
      <tbody>
        {
          items.map((f) => (
            <tr>
              <th scope="row">{f.name}</th>
              <td>
                {f.about}
                {f.link && (
                  <>
                    {' '}
                    <a class="table-link arrow" href={f.link.href}>{f.link.label}</a>
                  </>
                )}
              </td>
              <td class="mark" data-label="読む">
                <span class:list={['status-badge', markClass[f.read]]}>{f.read}</span>
              </td>
              <td class="mark" data-label="書く">
                <span class:list={['status-badge', markClass[f.write]]}>{f.write}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
