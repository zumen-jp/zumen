---
// GitHub へ誘う枠。トップと下層のページの終わりに置く。
import { repo } from '../data/site';
---

<section class="section section-cta" aria-labelledby="cta-title">
  <div class="wrap">
    <div class="cta">
      <h2 id="cta-title">開発の進み具合は、GitHub で公開しています</h2>
      <p>設計・決めたこと・次の作業を、すべて GitHub で見られます。不具合の報告や提案も、GitHub で受け付けています。</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={repo}>GitHub で見る</a>
      </div>
    </div>
  </div>
</section>
