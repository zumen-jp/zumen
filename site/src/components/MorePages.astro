---
// ほかのページへの案内。下層のページの終わりに置く。6 ページを 3 列 × 2 行の均整な目録として並べる。
import { nav, pages, webEditor } from '../data/site';

interface Props {
  current: string;
}

const { current } = Astro.props;
const sheetCodes: Record<(typeof nav)[number]['href'], string> = {
  [webEditor]: 'V-01',
  '/plugins/': 'E-01',
  '/features/': 'A-02',
  '/formats/': 'C-01',
  '/platforms/': 'A-03',
  '/news/': 'M-01',
  '/faq/': 'S-01',
};
---

<ul class="page-links">
  {
    nav
      .filter((page) => page.href !== current)
      .map((page) => (
        <li>
          <a href={page.href}>
            <span class="page-links-meta">
              <span class="shoulder" lang="en">{pages[page.href].en}</span>
              <span class="page-links-code" aria-hidden="true">{sheetCodes[page.href]}</span>
            </span>
            <strong>{page.label}</strong>
            <span class="page-links-lead">{pages[page.href].lead}</span>
          </a>
        </li>
      ))
  }
</ul>
