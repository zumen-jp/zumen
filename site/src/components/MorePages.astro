---
// ほかのページへの案内。下層のページの終わりに置く。
import { nav, pages } from '../data/site';

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<ul class="page-links">
  {
    nav
      .filter((page) => page.href !== current)
      .map((page) => (
        <li>
          <a href={page.href}>
            <span class="shoulder" lang="en">{pages[page.href].en}</span>
            <strong>{page.label}</strong>
            <span class="page-links-lead">{pages[page.href].lead}</span>
          </a>
        </li>
      ))
  }
</ul>
