{
  "name": "zumen-workspace",
  "private": true,
  "description": "文書の表記の検査に使う道具（決定 0021）",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:text": "textlint \"**/*.md\" \".github/**/*.md\" && textlint --config .textlintrc.code.yml \"**/*.{rs,toml,yml}\" \".cargo/**/*.toml\" \".github/**/*.yml\"",
    "fix:text": "textlint --fix \"**/*.md\" \".github/**/*.md\""
  },
  "devDependencies": {
    "textlint": "15.8.0",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-ja-hiragana-fukushi": "1.3.0",
    "textlint-rule-ja-hiragana-hojodoushi": "1.1.0",
    "textlint-rule-ja-hiragana-keishikimeishi": "1.1.0",
    "textlint-rule-preset-ja-spacing": "3.0.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-prh": "6.1.0"
  }
}
