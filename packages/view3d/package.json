{
  "name": "@zumen-jp/view3d",
  "version": "0.4.0",
  "description": "zumen の 3D のシーン（ZMS3）を WebGPU で描く表示部品",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumen-jp/zumen.git",
    "directory": "packages/view3d"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
