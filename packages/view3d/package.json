    },
    "./pointcloud": {
      "types": "./src/pointcloud.d.ts",
      "default": "./src/pointcloud.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@zumen-jp/zumen": "^0.4.0",
